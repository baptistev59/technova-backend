{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié | TechNova{% endblock %}

{% form_theme requestForm 'form/tailwind_form_theme.html.twig' %}

{% block body %}
<section class="mx-auto max-w-3xl rounded-[32px] bg-white p-10 shadow-2xl">
    <div class="space-y-3">
        <p class="text-sm font-semibold uppercase tracking-widest text-blue-400">Sécurité</p>
        <h1 class="text-3xl font-bold text-slate-900">Mot de passe oublié</h1>
        <p class="text-slate-500">Saisis ton email pour recevoir un lien valable 5 minutes.</p>
    </div>

    {% for flash in app.flashes('reset_password_error') %}
        <div class="mt-6 rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
            {{ flash }}
        </div>
    {% endfor %}

    {{ form_start(requestForm, { attr: { class: 'mt-6 space-y-6' } }) }}
        {{ form_row(requestForm.email) }}
        <button class="inline-flex w-full items-center justify-center rounded-2xl bg-blue-600 px-5 py-3 text-lg font-semibold text-white shadow-lg shadow-blue-400/40 transition hover:-translate-y-0.5 hover:bg-blue-500 md:w-auto">
            Envoyer le lien
        </button>
    {{ form_end(requestForm) }}

    <p class="mt-6 text-sm text-slate-500">
        <a class="text-blue-600 hover:underline" href="{{ path('app_login') }}">Retour à la connexion</a>
    </p>
</section>
{% endblock %}
