{% extends 'base.html.twig' %}

{% block title %}Lien envoyé | TechNova{% endblock %}

{% block body %}
<section class="mx-auto max-w-3xl rounded-[32px] bg-white p-10 text-center shadow-2xl">
    <h1 class="text-3xl font-bold text-slate-900">Vérifie ta boîte mail</h1>
    <p class="mt-4 text-slate-500">
        Si un compte existe avec cet email, un lien de réinitialisation vient d’être envoyé.
        Il expire dans 5 minutes.
    </p>
    <p class="mt-4 text-xs text-slate-400">
        {{ resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle') }}
    </p>
    <a class="mt-8 inline-flex items-center justify-center rounded-2xl border-2 border-blue-500 px-5 py-2 font-semibold text-blue-600 transition hover:bg-blue-500 hover:text-white" href="{{ path('app_login') }}">
        Retour à la connexion
    </a>
</section>
{% endblock %}
