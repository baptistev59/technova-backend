{% extends 'base.html.twig' %}

{% block title %}Configurer la double authentification{% endblock %}

{% block body %}
    <section class="max-w-2xl mx-auto py-12 px-6">
        <h1 class="text-2xl font-semibold text-slate-900 mb-4">{{ 'Configurer la double authentification'|trans }}</h1>
        <p class="text-sm text-slate-600 mb-6">{{ 'Scanne le QR code avec ton application d authentification ou saisis la clef manuellement.'|trans }}</p>

        <div class="rounded-2xl border border-slate-200 bg-white p-6 space-y-4">
            <div class="flex justify-center">
                <img
                    src="{{ qr_data_uri }}"
                    alt="QR code TOTP"
                    class="h-56 w-56"
                >
            </div>
            <div>
                <p class="text-xs uppercase tracking-[0.2em] text-slate-400">{{ 'Clef secrete'|trans }}</p>
                <p class="font-mono text-lg text-slate-900 break-all">{{ secret }}</p>
            </div>
            <div>
                <p class="text-xs uppercase tracking-[0.2em] text-slate-400">{{ 'Lien QR'|trans }}</p>
                <p class="text-xs text-slate-500 break-all">{{ qr_content }}</p>
            </div>
            <form method="post">
                <input type="hidden" name="_token" value="{{ csrf_token('two_factor_setup') }}">
                <button class="btn btn-primary" type="submit">{{ 'Valider'|trans }}</button>
            </form>
        </div>
    </section>
{% endblock %}
