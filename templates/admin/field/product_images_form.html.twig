<div class="space-y-3 text-sm text-slate-600">
    {% if field.value is not empty %}
        <div class="rounded-2xl border border-slate-100 bg-slate-50 p-4 space-y-3">
            <div class="flex items-center justify-between">
                <p class="text-sm font-semibold text-slate-700">Visuels existants</p>
                <span class="text-xs text-slate-500">La photo principale est cochée</span>
            </div>
            <div class="grid gap-3 md:grid-cols-3">
                {% for image in field.value %}
                    {% if image.id is not null %}
                        <label class="relative flex flex-col gap-2 rounded-2xl border border-slate-200 bg-white p-3 text-slate-600 transition hover:shadow-lg">
                            <div class="h-40 rounded-xl bg-slate-100">
                                <img src="{{ asset(image.url) }}"
                                     alt="{{ image.alt ?? image.title ?? 'Visuel produit' }}"
                                     class="h-full w-full rounded-xl object-cover">
                            </div>
                            <div class="flex items-center justify-between text-xs text-slate-500">
                                <span>{{ image.title ?? 'Visuel #' ~ loop.index }}</span>
                                <span>Position {{ image.position ?? '?' }}</span>
                            </div>
                            <div class="flex items-center justify-between gap-3 text-xs">
                                <label class="flex items-center gap-2">
                                    <input type="checkbox" name="remove_images[]" value="{{ image.id }}" class="h-4 w-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500">
                                    Supprimer
                                </label>
                                <label class="flex items-center gap-2">
                                    <input type="radio" name="main_image_id" value="{{ image.id }}" {% if image.isMain %}checked{% endif %} class="h-4 w-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500">
                                    Image principale
                                </label>
                            </div>
                            {% if image.isMain %}
                                <span class="absolute top-3 right-3 rounded-full bg-blue-50 px-2 py-1 text-[10px] font-semibold text-blue-600">Principale</span>
                            {% endif %}
                        </label>
                    {% endif %}
                {% endfor %}
            </div>
        </div>
    {% else %}
        <p>Pas encore d’image associée à ce produit.</p>
    {% endif %}
    <p class="text-xs text-slate-500">Coche les visuels à supprimer et sélectionne la photo principale si besoin.</p>
</div>
