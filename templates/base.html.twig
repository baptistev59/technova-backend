<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {% if viewer_user() %}
        <meta name="jwt-token" content="{{ app.session.get('jwt_token', '') }}">
    {% endif %}
    <title>{% block title %}TechNova Marketplace{% endblock %}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
    {% if app.environment == 'dev' or app.environment == 'test' %}
        {{ encore_entry_link_tags('app')|raw }}
    {% endif %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">
    {% if app.environment == 'dev' or app.environment == 'test' %}
        {{ importmap('app') }}
    {% endif %}
    <style>
        /* Suggestions de recherche */
        .tn-search__form {
            position: relative;
        }
        .tn-search-suggestions {
            position: absolute;
            top: calc(100% + 0.35rem);
            left: 0;
            right: 0;
            margin-top: 0.25rem;
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 18px;
            box-shadow: 0 35px 60px rgba(15, 23, 42, 0.12);
            padding: 0.5rem 0;
            z-index: 50;
            max-height: 240px;
            overflow-y: auto;
        }
        .tn-search-suggestions__item {
            width: 100%;
            border: none;
            background: transparent;
            text-align: left;
            padding: 0.6rem 1rem;
            font-size: 0.95rem;
            color: #0f172a;
            cursor: pointer;
            transition: background-color 0.2s ease;
            line-height: 1.4;
        }
        .tn-search-suggestions__item + .tn-search-suggestions__item {
            border-top: 1px solid #e2e8f0;
        }
        .tn-search-suggestions__item:hover,
        .tn-search-suggestions__item--active {
            background: #eef2ff;
        }
        .tn-search-suggestions.hidden {
            display: none;
        }
        .tn-favorites-counter {
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
            padding: 0.3rem 0.8rem;
            border-radius: 999px;
            font-size: 0.95rem;
            font-weight: 600;
            color: #0f172a;
            border: 1px solid transparent;
            transition: background-color 0.2s ease, border-color 0.2s ease;
            text-decoration: none;
        }
        .tn-favorites-counter:hover {
            border-color: rgba(15, 23, 42, 0.1);
            background-color: #f1f5f9;
        }
    </style>
    <link rel="icon" href="{{ asset('favicon.ico') }}" type="image/x-icon">
    <meta name="technova-jwt" content="{{ app.session.get('jwt_token') ?? '' }}">
    <script src="//unpkg.com/alpinejs" defer></script>
</head>
<body>
    {% set viewer = viewer_user() %}
{% set viewer_is_vendor = viewer and 'ROLE_VENDOR' in viewer.roles %}
{% set viewer_is_admin = viewer and 'ROLE_ADMIN' in viewer.roles %}
    <header class="tn-header">
        <div class="tn-topbar">
            {# En-tête principal disponible sur toutes les pages #}
            <a class="tn-logo" href="{{ path('homepage') }}">
                <img class="tn-logo-img" src="{{ asset('images/branding/logo-technova.png') }}" alt="TechNova">
            </a>
            <nav class="tn-nav-links">
                <a href="{{ path('catalog_index') }}">Produits</a>
                <a href="{{ path('shop_index') }}">Boutiques</a>
                <a href="#">Aide</a>
            </nav>
            <div class="tn-actions">
                <div class="tn-search max-w-xs w-full">
                    <form class="tn-search__form relative" method="get" action="{{ path('catalog_index') }}">
                        <label for="global-search" class="sr-only">Rechercher un produit</label>
                        <input
                            type="search"
                            id="global-search"
                            name="search"
                            placeholder="Rechercher un produit…"
                            value="{{ app.request.get('search') }}"
                            minlength="2"
                            required
                            autocomplete="off"
                            autocorrect="off"
                            autocapitalize="off"
                            spellcheck="false"
                        >
                        <div class="tn-search-suggestions hidden" data-search-suggestions></div>
                    </form>
                </div>
                <div class="tn-auth">
                {% if viewer %}
                    <a
                        class="tn-favorites-counter"
                        href="{{ path('app_wishlist_list') }}"
                        aria-label="Voir mes favoris"
                        x-data="{ count: 0 }"
                        x-init="
                            const fetchCount = async () => {
                                try {
                                    const response = await fetch('/api/wishlists/count', {
                                        headers: {
                                            'Authorization': 'Bearer ' + document.querySelector('meta[name=jwt-token]')?.content
                                        }
                                    });
                                    if (response.ok) {
                                        const data = await response.json();
                                        count = data.count;
                                    }
                                } catch (error) {
                                    console.error('Erreur lors de la récupération du compteur', error);
                                }
                            };
                            fetchCount();
                            window.addEventListener('wishlist-updated', fetchCount);
                        "
                    >
                        ❤️ <span x-text="count"></span>
                    </a>
                    {% set first_initial = (viewer.firstname ?? 'T')|slice(0, 1) %}
                    {% set last_initial = (viewer.lastname ?? 'N')|slice(0, 1) %}
                    {% set initials = (first_initial ~ last_initial)|upper %}
                    <details class="tn-user-menu">
                        <summary class="tn-user-menu__trigger">
                            <span class="tn-user-avatar">
                                {% if viewer.avatarPath %}
                                    <img src="{{ asset(viewer.avatarPath) }}" alt="{{ viewer.firstname }}">
                                {% else %}
                                    {{ initials }}
                                {% endif %}
                            </span>
                            <span class="tn-user-name">{{ viewer.firstname }}</span>
                            <svg xmlns="http://www.w3.org/2000/svg" class="tn-user-chevron" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" focusable="false">
                                <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.252l3.71-4.02a.75.75 0 111.08 1.04l-4.25 4.61a.75.75 0 01-1.08 0l-4.25-4.61a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
                            </svg>
                        </summary>
                        <div class="tn-user-menu__panel">
                            <a class="tn-user-menu__item" href="{{ path('app_profile') }}">Mon profil</a>
                            {% if viewer_is_vendor %}
                                <a class="tn-user-menu__item" href="{{ path('app_vendor_shop_new') }}">Mon espace vendeur</a>
                            {% endif %}
                            {% if viewer_is_admin %}
                                <a class="tn-user-menu__item" href="{{ path('admin_dashboard') }}">Backoffice admin</a>
                            {% endif %}
                            <a class="tn-user-menu__item" href="{{ path('app_wishlist_list') }}">❤️ Mes favoris</a>
                            <a class="tn-user-menu__item" href="{{ path('app_account_orders') }}">Mes commandes</a>
                            <a class="tn-user-menu__item" href="{{ path('app_cart_show') }}">Mon panier</a>
                            <form method="post" action="{{ path('app_logout') }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('logout') }}">
                                <button type="submit" class="tn-user-menu__item btn-link">Déconnexion</button>
                            </form>
                        </div>
                    </details>
                {% else %}
                    <a class="btn btn-outline" href="{{ path('app_login') }}">Connexion</a>
                    <a class="btn btn-primary" href="{{ path('app_register') }}">S’inscrire</a>
                {% endif %}
                </div>
            </div>
        </div>
    </header>
    <main class="tn-main">
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="mb-4 rounded-2xl border border-blue-200 bg-blue-50 px-4 py-2 text-blue-800">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}
        {% block body %}{% endblock %}
    </main>

    <footer class="tn-footer">
        <div class="tn-footer__brand">
            <div class="tn-logo">
                <img class="tn-logo-img" src="{{ asset('images/branding/logo-technova.png') }}" alt="TechNova">
            </div>
        </div>
        <div class="tn-footer__grid">
            <div>
                <h2>À propos</h2>
                <a href="#">Qui sommes-nous</a>
                <a href="#">Carrières</a>
                <a href="#">Blog</a>
                <a href="#">Presse</a>
            </div>
            <div>
                <h2>Aide</h2>
                <a href="#">Centre d’aide</a>
                <a href="#">Livraison</a>
                <a href="#">Retours</a>
                <a href="#">Contact</a>
            </div>
            <div>
                <h2>Légal</h2>
                <a href="#">CGV</a>
                <a href="#">Mentions légales</a>
                <a href="#">Confidentialité</a>
                <a href="#">Cookies</a>
            </div>
            <div class="tn-footer__social">
                <h2>Réseaux</h2>
                <div class="tn-social-icons">
                    <span>✕</span>
                    <span>📸</span>
                    <span>💼</span>
                    <span>📘</span>
                </div>
            </div>
        </div>
        <div class="tn-footer__bottom">&copy; {{ "now"|date("Y") }} TechNova Marketplace. Tous droits réservés.</div>
    </footer>

    {% block javascripts %}
        {# Webpack Encore only in dev/test - see lines 648-649 for conditional loading #}
        {# {{ encore_entry_script_tags('app') }} #}
        {# {{ encore_entry_script_tags('app')|raw }} #}
        <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
        <script>
            (() => {
            const initSwipers = () => {
                document.querySelectorAll('[data-swiper-init]').forEach((swiperEl) => {

                    if (swiperEl.swiper) {
                        return;
                    }

                    const paginationEl = swiperEl.querySelector('.swiper-pagination');
                    const nextEl = swiperEl.querySelector('.swiper-button-next');
                    const prevEl = swiperEl.querySelector('.swiper-button-prev');

                    const slidesCount = swiperEl.querySelectorAll('.swiper-slide').length;
                    const max = (value) => Math.min(value, slidesCount);

                    new Swiper(swiperEl, {
                        loop: false,
                        spaceBetween: 16,
                        grabCursor: true,

                        slidesPerView: max(1),
                        slidesPerGroup: max(1),

                        observer: true,
                        observeParents: true,
                        resizeObserver: true,

                        breakpoints: {
                            640:  { slidesPerView: max(2), slidesPerGroup: max(2) },
                            768:  { slidesPerView: max(3), slidesPerGroup: max(3) },
                            1024: { slidesPerView: max(4), slidesPerGroup: max(4) },
                            1280: { slidesPerView: max(5), slidesPerGroup: max(5) },
                        },

                        pagination: {
                            el: paginationEl,
                            clickable: true,
                            dynamicBullets: true,
                        },

                        navigation: {
                            nextEl,
                            prevEl,
                        },
                    });

                });
            };

            const initCatalogSuggestion = () => {
                const suggestionsUrl = '{{ path('catalog_product_suggestions') }}';
                const searchInputs = Array.from(document.querySelectorAll('input[name="search"]'));
                if (searchInputs.length === 0) {
                    return;
                }

                const stateMap = new WeakMap();
                const controllersMap = new WeakMap();
                const getState = (input) => stateMap.get(input) ?? { items: [], activeIndex: -1, canOpen: true };
                const setState = (input, updates) => {
                    const current = getState(input);
                    const next = { ...current, ...updates };
                    stateMap.set(input, next);
                    return next;
                };

                const closeSuggestions = (input) => {
                    const controllerStore = controllersMap.get(input);
                    if (controllerStore?.current) {
                        controllerStore.current.abort();
                        controllerStore.current = null;
                    }

                    const container = input.closest('form')?.querySelector('[data-search-suggestions]');
                    if (container) {
                        container.classList.add('hidden');
                        container.innerHTML = '';
                    }
                    setState(input, { items: [], activeIndex: -1, canOpen: false });
                };

                const renderSuggestions = (input, items) => {
                    const container = input.closest('form')?.querySelector('[data-search-suggestions]');
                    if (!container) {
                        return;
                    }
                    const state = getState(input);
                    if (!state.canOpen && items.length) {
                        return;
                    }
                    container.innerHTML = '';
                    if (!items.length) {
                        container.classList.add('hidden');
                        setState(input, { items: [], activeIndex: -1, canOpen: false });
                        return;
                    }
                    items.slice(0, 40).forEach((item, index) => {
                        const button = document.createElement('button');
                        button.type = 'button';
                        button.className = 'tn-search-suggestions__item';
                        button.textContent = item;
                        button.addEventListener('mousedown', (event) => event.preventDefault());
                    button.addEventListener('click', () => {
                        input.value = item;
                        closeSuggestions(input);
                        input.blur();
                        input.form?.requestSubmit();
                    });
                        container.appendChild(button);
                    });
                    container.classList.remove('hidden');
                    setState(input, { items, activeIndex: -1, canOpen: true });
                };

                const requestSuggestions = (query, input, controllerStore) => {
                    if (query.length < 3) {
                        renderSuggestions(input, []);
                        return;
                    }

                    if (controllerStore.current) {
                        controllerStore.current.abort();
                    }
                    controllerStore.current = new AbortController();
                    fetch(`${suggestionsUrl}?query=${encodeURIComponent(query)}`, { signal: controllerStore.current.signal })
                        .then((response) => response.ok ? response.json() : Promise.reject(new Error('Chargement des suggestions impossible')))
                        .then((payload) => Array.isArray(payload) ? payload : [])
                        .then((payload) => renderSuggestions(input, payload))
                        .catch((error) => {
                            if (error.name !== 'AbortError') {
                                console.error(error);
                            }
                        });
                };

                const updateActive = (input, delta) => {
                    const state = getState(input);
                    const container = input.closest('form')?.querySelector('[data-search-suggestions]');
                    if (!state || !container) {
                        return;
                    }
                    const buttons = Array.from(container.children);
                    if (!buttons.length) {
                        return;
                    }
                    let nextIndex = state.activeIndex + delta;
                    if (nextIndex < 0) {
                        nextIndex = buttons.length - 1;
                    }
                    if (nextIndex >= buttons.length) {
                        nextIndex = 0;
                    }
                    buttons.forEach((button, index) => button.classList.toggle('tn-search-suggestions__item--active', index === nextIndex));
                    buttons[nextIndex].scrollIntoView({ block: 'nearest' });
                    setState(input, { activeIndex: nextIndex });
                };

                const attachHandlers = (input) => {
                    const controllerStore = { current: null };
                    controllersMap.set(input, controllerStore);
                    let timeout;
                    setState(input, { items: [], activeIndex: -1, canOpen: false });

                    input.addEventListener('input', ({ target }) => {
                        clearTimeout(timeout);
                        setState(input, { canOpen: true });
                        timeout = window.setTimeout(() => requestSuggestions(target.value.trim(), input, controllerStore), 250);
                    });

                    input.addEventListener('keydown', (event) => {
                        if (event.key === 'ArrowDown') {
                            event.preventDefault();
                            updateActive(input, 1);
                            return;
                        }

                        if (event.key === 'ArrowUp') {
                            event.preventDefault();
                            updateActive(input, -1);
                            return;
                        }

                        if (event.key === 'Escape') {
                            closeSuggestions(input);
                            return;
                        }

                        if (event.key === 'Enter') {
                            const state = getState(input);
                            const container = input.closest('form')?.querySelector('[data-search-suggestions]');
                            const buttons = container ? Array.from(container.children) : [];
                            if (state && state.activeIndex >= 0 && buttons[state.activeIndex]) {
                                event.preventDefault();
                                buttons[state.activeIndex].click();
                                return;
                            }
                            closeSuggestions(input);
                        }
                    });

                    input.addEventListener('focus', () => {
                        const state = getState(input);
                        if (state && state.items.length && state.canOpen) {
                            const container = input.closest('form')?.querySelector('[data-search-suggestions]');
                            container?.classList.remove('hidden');
                        }
                    });

                    input.addEventListener('blur', () => {
                        window.setTimeout(() => closeSuggestions(input), 150);
                    });

                    input.form?.addEventListener('submit', () => closeSuggestions(input));
                };

                searchInputs.forEach(attachHandlers);
            };

            const getGridColumnsCount = (gridEl) => {
                const style = window.getComputedStyle(gridEl);
                const gap = parseFloat(style.columnGap) || 0;
                const card = gridEl.querySelector('.tn-product-card');
                if (!card) {
                    return 1;
                }
                const gridWidth = gridEl.getBoundingClientRect().width;
                const cardWidth = card.getBoundingClientRect().width;
                return Math.max(1, Math.floor((gridWidth + gap) / (cardWidth + gap)));
            };

            const initRowsPagination = () => {
                const form = document.querySelector('form.tn-filters');
                const grid = document.querySelector('.tn-products-grid');
                const rowsSelect = document.getElementById('catalog-rows');
                const limitInput = form?.querySelector('input[name="limit"]');
                const pageInput = form?.querySelector('input[name="page"]');

                if (!form || !grid || !rowsSelect || !limitInput || !pageInput) {
                    return;
                }

                const applyRows = () => {
                    const rows = parseInt(rowsSelect.value, 10) || 10;
                    const columns = getGridColumnsCount(grid);
                    const computedLimit = Math.max(1, rows * Math.max(1, columns));
                    limitInput.value = String(computedLimit);
                    pageInput.value = '1';
                    form.requestSubmit();
                };

                rowsSelect.addEventListener('change', applyRows);
            };

            const applyPageEnhancements = () => {
                initSwipers();
                initCatalogSuggestion();
                initRowsPagination();
            };

            document.addEventListener('DOMContentLoaded', applyPageEnhancements);
            document.addEventListener('turbo:load', applyPageEnhancements);
            })();
        </script>
        <script>
            document.addEventListener('DOMContentLoaded', () => {
                const jwtMeta = document.querySelector('meta[name="technova-jwt"]');
                const bearer = jwtMeta?.getAttribute('content')?.trim();
                if (!bearer) {
                    return;
                }

                const panels = document.querySelectorAll('.tn-conversation-panel[data-order-id][data-api-base]');
                if (!panels.length) {
                    return;
                }

                const headers = {
                    'Authorization': `Bearer ${bearer}`,
                    'Accept': 'application/json',
                };

                const formatDate = (value) => {
                    if (!value) {
                        return '';
                    }
                    const date = new Date(value);
                    return date.toLocaleString('fr-FR', { dateStyle: 'short', timeStyle: 'short' });
                };

                panels.forEach((panel) => {
                    const orderId = panel.dataset.orderId;
                    const apiBase = panel.dataset.apiBase;
                    const messagesEl = panel.querySelector('[data-conversation-messages]');
                    const formEl = panel.querySelector('[data-conversation-form]');
                    const statusEl = panel.querySelector('[data-conversation-status]');
                    const textarea = formEl?.querySelector('textarea[name="content"]');

                    const renderMessages = (messages) => {
                        if (!messagesEl) {
                            return;
                        }
                        messagesEl.innerHTML = '';
                        if (!messages.length) {
                            const empty = document.createElement('p');
                            empty.className = 'text-sm text-slate-400';
                            empty.textContent = 'Aucun message pour le moment.';
                            messagesEl.appendChild(empty);
                            return;
                        }
                        messages.forEach((message) => {
                            const wrapper = document.createElement('div');
                            wrapper.className = 'rounded-2xl border border-slate-200 bg-white px-3 py-2 text-sm';

                            const header = document.createElement('p');
                            header.className = 'text-[0.65rem] uppercase tracking-[0.35em] text-slate-400 mb-1';
                            header.textContent = `${message.authorName} · ${formatDate(message.createdAt)}`;

                            const content = document.createElement('p');
                            content.className = 'text-sm text-slate-700';
                            content.textContent = message.content;

                            wrapper.appendChild(header);
                            wrapper.appendChild(content);
                            messagesEl.appendChild(wrapper);
                        });
                        messagesEl.scrollTop = messagesEl.scrollHeight;
                    };

                    const loadMessages = () => {
                        if (!messagesEl) {
                            return;
                        }
                        messagesEl.innerHTML = '<p class="text-sm text-slate-400">Chargement…</p>';
                        fetch(`${apiBase}/${orderId}`, { headers })
                            .then((response) => {
                                if (!response.ok) {
                                    throw new Error('Impossible de charger');
                                }
                                return response.json();
                            })
                            .then((payload) => {
                                renderMessages(payload.messages || []);
                                if (statusEl) {
                                    statusEl.textContent = '';
                                }
                            })
                            .catch(() => {
                                if (statusEl) {
                                    statusEl.textContent = 'Impossible de charger la conversation.';
                                }
                            });
                    };

                    formEl?.addEventListener('submit', (event) => {
                        event.preventDefault();
                        const content = textarea?.value.trim() ?? '';
                        if (!content) {
                            if (statusEl) {
                                statusEl.textContent = 'Le message ne peut pas être vide.';
                            }
                            return;
                        }
                        textarea.disabled = true;
                        fetch(`${apiBase}/${orderId}/messages`, {
                            method: 'POST',
                            headers: {
                                ...headers,
                                'Content-Type': 'application/x-www-form-urlencoded',
                            },
                            body: new URLSearchParams({ content }),
                        })
                            .then((response) => {
                                if (!response.ok) {
                                    throw new Error('Erreur');
                                }
                                return response.json();
                            })
                            .then(() => {
                                textarea.value = '';
                                if (statusEl) {
                                    statusEl.textContent = '';
                                }
                                loadMessages();
                            })
                            .catch(() => {
                                if (statusEl) {
                                    statusEl.textContent = 'Impossible d’envoyer le message.';
                                }
                            })
                            .finally(() => {
                                textarea.disabled = false;
                            });
                    });

                    loadMessages();
                });
            });
        </script>
    {% endblock %}
    {% if app.environment == 'dev' or app.environment == 'test' %}
        {{ encore_entry_script_tags('app')|raw }}
        {{ encore_entry_script_tags('product-form')|raw }}
    {% endif %}
</body>
</html>
