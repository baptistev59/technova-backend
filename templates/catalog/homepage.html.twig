{% extends 'base.html.twig' %}

{% block title %}Accueil | TechNova{% endblock %}

{% block body %}
{# Section hero : message marketing et call to action #}
<section class="tn-hero">
    <div class="tn-hero__text">
        <h1>Explorez le monde de l’innovation technologique</h1>
        <p>Trouvez les meilleurs produits tech, en quelques clics.</p>
        <div class="tn-hero__actions">
            <a href="{{ path('catalog_index') }}" class="btn btn-primary">Parcourir les produits</a>
            <a href="{{ path('shop_index') }}" class="btn btn-outline">Découvrir les boutiques</a>
        </div>
    </div>
    <div class="tn-hero__visual">
        <img src="{{ asset('images/hero/hero-immersive-lab.svg') }}" alt="Innovation TechNova">
    </div>
</section>

{# Mise en avant des catégories clés #}
{% import '_macros/media.html.twig' as media %}

<section class="tn-section">
    <div class="tn-section__header">
        <h2>Catégories populaires</h2>
    </div>
    <div class="tn-categories">
        {% for category in categories %}
            {% set iconPath = category.iconPath ?? 'images/categories/category-default.svg' %}
            {% if iconPath and not (iconPath starts with 'images/' or iconPath starts with 'http' or iconPath starts with '/') %}
                {% set iconPath = 'images/categories/' ~ iconPath %}
            {% endif %}
            <a class="tn-category-card" href="{{ path('catalog_index', { category: category.slug }) }}">
                <div class="tn-category-card__icon">
                    <img src="{{ asset(iconPath) }}" alt="Icône {{ category.name }}">
                </div>
                <p>{{ category.name }}</p>
            </a>
        {% else %}
            <p>Aucune catégorie disponible.</p>
        {% endfor %}
    </div>
</section>

{# Carrousel simplifié des derniers produits #}
<section class="tn-section">
    <div class="tn-section__header">
        <h2>Nouveautés</h2>
        <a href="{{ path('catalog_index') }}">Voir tout</a>
    </div>
    <p class="tn-section__hint">Une sélection de 10 nouveautés, mise à jour chaque jour.</p>
    {% if latestProducts|length %}
        <div class="swiper tn-carousel" data-swiper-init data-swiper-visible="5">
            <div class="swiper-wrapper">
                {% for product in latestProducts|slice(0, 10) %}
                    <div class="swiper-slide p-3 h-auto">
                        <article class="tn-product-card tn-product-card--carousel h-full flex flex-col">
                            <div class="tn-product-card__media">
                                {% set mainImage = product.primaryImage %}
                                {% set imageSrc = media.image_src(mainImage ? mainImage.url : null, 'assets/images/product-placeholder.svg') %}
                                <img
                                    src="{{ imageSrc }}"
                                    alt="{{ mainImage ? mainImage.alt : 'Visuel par défaut' }}"
                                    loading="lazy"
                                >
                            </div>

                            <h3 class="tn-product-card__title tn-title--truncate" title="{{ product.name }}">{{ product.name }}</h3>
                            {% set reviewSummary = review_summaries[product.id] ?? null %}
                            {% set avgRating = reviewSummary ? reviewSummary.avg : 0 %}
                            {% set reviewCount = reviewSummary ? reviewSummary.count : 0 %}
                            <div class="flex items-center gap-2">
                                {{ include('partials/_rating_display.html.twig', { rating: avgRating }) }}
                                <span class="tn-rating__count">({{ reviewCount }})</span>
                            </div>

                            <div class="tn-product-card__meta">
                                <span>{{ product.brand ? product.brand.name : product.shop.name }}</span>
                                <strong>{{ product.price|number_format(2, ',', ' ') }} €</strong>
                            </div>
                            <div class="mt-2 text-xs text-blue-600">
                                <a href="{{ path('shop_show', { slug: product.shop.slug }) }}" class="hover:underline">Boutique {{ product.shop.name }}</a>
                            </div>
                            <div class="tn-product-card__cta mt-auto">
                            <a class="btn btn-primary" href="{{ path('product_show', {slug: product.slug}) }}">Voir le produit</a>
                            </div>
                        </article>
                    </div>

                {% endfor %}
            </div>
            <div class="swiper-pagination"></div>
            <div class="swiper-button-prev"></div>
            <div class="swiper-button-next"></div>
        </div>
    {% else %}
        <p>Aucun produit récent n'est disponible.</p>
    {% endif %}
</section>

{# Sélection "à la une" alimentée via isFeatured #}
<section class="tn-section">
    <div class="tn-section__header">
        <h2>Produits à la une</h2>
        <a href="{{ path('catalog_index', { sort: 'price_desc' }) }}">Découvrir la sélection</a>
    </div>
    <p class="tn-section__hint">10 choix exclusifs mis à jour quotidiennement.</p>
    {% if featuredProducts|length %}
        <div class="swiper tn-carousel" data-swiper-init data-swiper-visible="5">
            <div class="swiper-wrapper">
                {% for product in featuredProducts|slice(0, 10) %}
                    <div class="swiper-slide p-3 h-auto">
                        <article class="tn-product-card tn-product-card--carousel h-full flex flex-col">
                            <div class="tn-product-card__media">
                            {% set mainImage = product.primaryImage %}
                            {% set imageSrc = mainImage
                                ? (mainImage.url starts with 'http'
                                    ? mainImage.url
                                    : asset(mainImage.url)
                                )
                                : asset('assets/images/product-placeholder.svg')
                            %}

                            <img
                                src="{{ imageSrc }}"
                                alt="{{ mainImage ? mainImage.alt : 'Visuel par défaut' }}"
                                loading="lazy"
                            >
                            </div>

                            <h3 class="tn-product-card__title tn-title--truncate" title="{{ product.name }}">{{ product.name }}</h3>
                            {% set reviewSummary = review_summaries[product.id] ?? null %}
                            {% set avgRating = reviewSummary ? reviewSummary.avg : 0 %}
                            {% set reviewCount = reviewSummary ? reviewSummary.count : 0 %}
                            <div class="flex items-center gap-2">
                                {{ include('partials/_rating_display.html.twig', { rating: avgRating }) }}
                                <span class="tn-rating__count">({{ reviewCount }})</span>
                            </div>

                            <div class="tn-product-card__meta">
                            <span>{{ product.brand ? product.brand.name : product.shop.name }}</span>
                            <strong>{{ product.price|number_format(2, ',', ' ') }} €</strong>
                            </div>
                            <div class="mt-2 text-xs text-blue-600">
                                <a href="{{ path('shop_show', { slug: product.shop.slug }) }}" class="hover:underline">Boutique {{ product.shop.name }}</a>
                            </div>
                            <div class="tn-product-card__cta mt-auto">
                            <a class="btn btn-primary" href="{{ path('product_show', {slug: product.slug}) }}">Voir le produit</a>
                            </div>
                        </article>
                    </div>
                {% endfor %}
            </div>
            <div class="swiper-pagination"></div>
            <div class="swiper-button-prev"></div>
            <div class="swiper-button-next"></div>
        </div>
    {% else %}
        <p>Aucun produit à la une pour le moment.</p>
    {% endif %}
</section>

{# Bandeau promotionnel inspiré de la maquette #}
<section class="tn-banner">
    <div>
        <p>Jusqu'à -30% sur les nouveautés tech</p>
        <a class="btn btn-outline" href="{{ path('catalog_index') }}">Voir les offres</a>
    </div>
</section>
{% endblock %}
