{% extends 'base.html.twig' %}

{% block title %}{{ product.name }} | TechNova{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"/>
{% endblock %}

{% block body %}
{% set viewer = viewer_user() %}
{% set seller_vendor = product.shop.owner %}
{% set seller_user = seller_vendor and seller_vendor.owner ? seller_vendor.owner : null %}
{% set current_vendor = viewer and viewer.vendor ? viewer.vendor : null %}
{% set current_user = viewer %}
{% set can_edit = viewer and (
    is_granted('ROLE_ADMIN') or
    (seller_vendor is not null and current_vendor is not null and seller_vendor.id == current_vendor.id) or
    (seller_user is not null and current_user and seller_user.id == current_user.id)
) %}
{# Bloc principal affichant la galerie et les infos produit #}
{% if app.request.query.get('cart_added') %}
    <div class="mb-6 rounded-2xl border border-blue-200 bg-blue-50 p-4 flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
        <div>
            <p class="font-semibold text-slate-900">{{ product.name }} a bien été ajouté à votre panier.</p>
            <p class="text-sm text-slate-600">Vous pouvez continuer vos achats ou finaliser votre commande.</p>
        </div>
        <div class="flex gap-2">
            <a class="btn btn-outline" href="{{ path('catalog_index') }}">Continuer mes achats</a>
            <a class="btn btn-primary" href="{{ path('app_cart_show') }}">Voir le panier</a>
        </div>
    </div>
{% endif %}
{% set navQuery = contextShopId ? {'shop': contextShopId} : {} %}
{% if previousProduct or nextProduct %}
    <div class="flex items-center justify-between mb-6">
        <div>
            {% if previousProduct %}
                <a href="{{ path('product_show', {'slug': previousProduct.slug} | merge(navQuery)) }}"
                   class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white px-4 py-2 text-slate-700 hover:bg-slate-50">
                    ← Produit précédent
                </a>
            {% endif %}
        </div>
        <div class="text-xs uppercase tracking-[0.35em] text-slate-300">Navigation</div>
        <div>
            {% if nextProduct %}
                <a href="{{ path('product_show', {'slug': nextProduct.slug} | merge(navQuery)) }}"
                   class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white px-4 py-2 text-slate-700 hover:bg-slate-50">
                    Produit suivant →
                </a>
            {% endif %}
        </div>
    </div>
{% endif %}
{% set bundleComponentsActive = product.type == 'grouped' and bundleComponents is not empty %}
{% set bundleLeadingImage = null %}
{% set bundleLeadingAlt = null %}
{% if bundleComponentsActive %}
    {% set bundleComponentsJson = bundleComponents|json_encode %}
    {% set bundleDiscountValue = product.bundleDiscountPercent is not null ? product.bundleDiscountPercent|number_format(2, '.', '') : '0' %}
    {% for component in bundleComponents %}
        {% if not bundleLeadingImage and component.mainImageUrl %}
            {% set bundleLeadingImage = component.mainImageUrl %}
            {% set bundleLeadingAlt = component.mainImageAlt ?? component.name %}
        {% endif %}
    {% endfor %}
    <div x-data="bundleComposer({components: JSON.parse($el.dataset.components || '[]'), discount: parseFloat($el.dataset.discount || '0') || 0})"
         x-init="init()"
         x-cloak
         class="space-y-8"
         data-components="{{ bundleComponentsJson|e('html_attr') }}"
         data-discount="{{ bundleDiscountValue }}">
{% endif %}
<section class="tn-product-layout">
    {% set galleryImages = [] %}
    {% set galleryUrls = [] %}
    {% if bundleComponentsActive and bundleLeadingImage %}
        {% set leadingUrl = bundleLeadingImage starts with('http') ? bundleLeadingImage : asset(bundleLeadingImage) %}
        {% set galleryImages = galleryImages|merge([{
            'url': leadingUrl,
            'alt': bundleLeadingAlt ?? product.name
        }]) %}
        {% set galleryUrls = galleryUrls|merge([leadingUrl]) %}
    {% endif %}
    {% for image in product.images %}
        {% set imageUrl = image.url starts with('http') ? image.url : asset(image.url) %}
        {% set galleryImages = galleryImages|merge([{
            'url': imageUrl,
            'alt': image.alt ?? product.name
        }]) %}
        {% set galleryUrls = galleryUrls|merge([imageUrl]) %}
    {% endfor %}
    {% if bundleComponentsActive %}
        {% for component in bundleComponents %}
            {% set componentImageUrl = component.mainImageUrl %}
            {% if componentImageUrl %}
                {% set componentImageUrl = componentImageUrl starts with('http') ? componentImageUrl : asset(componentImageUrl) %}
                {% if componentImageUrl not in galleryUrls %}
                    {% set galleryImages = galleryImages|merge([{
                        'url': componentImageUrl,
                        'alt': component.mainImageAlt ?? component.name
                    }]) %}
                    {% set galleryUrls = galleryUrls|merge([componentImageUrl]) %}
                {% endif %}
            {% endif %}
        {% endfor %}
    {% endif %}
    {% if galleryImages is empty %}
        {% set galleryImages = [{
            'url': asset('assets/images/product-placeholder.svg'),
            'alt': 'Visuel par défaut'
        }] %}
        {% set galleryUrls = galleryUrls|merge([asset('assets/images/product-placeholder.svg')]) %}
    {% endif %}
    <div class="tn-product-gallery"
         x-data="productGallery($el.dataset.images, $el.dataset.placeholderUrl)"
         data-images="{{ galleryImages|json_encode|e('html_attr') }}"
         data-placeholder-url="{{ asset('assets/images/product-placeholder.svg') }}"
         @keydown.window.escape="closeLightbox()">
        <div class="tn-product-main"
             @mousemove="onZoom($event)"
             @mouseenter="zoomVisible = true"
             @mouseleave="zoomVisible = false"
             @click="openLightbox">
            <img x-ref="main" :src="currentImage.url" :alt="currentImage.alt">
            <div class="tn-zoom-lens"
                 x-show="zoomVisible"
                 x-transition
                 :style="zoomLensStyle"></div>
        </div>
        <div class="swiper tn-thumbs-swiper" x-show="images.length > 0">
            <div class="swiper-wrapper">
                <template x-for="(img, index) in images" :key="index">
                    <div class="swiper-slide">
                        <img :src="img.url"
                             :alt="img.alt"
                             class="tn-thumb"
                             :class="{'active': currentIndex === index}"
                             @click="selectImage(index)">
                    </div>
                </template>
            </div>
            <div class="swiper-button-prev"></div>
            <div class="swiper-button-next"></div>
        </div>
        <div class="tn-lightbox" x-show="lightbox" x-transition>
            <div class="tn-lightbox__backdrop" @click="closeLightbox"></div>
            <div class="tn-lightbox__content">
                <button type="button" class="tn-lightbox__close" @click="closeLightbox">×</button>
                <img :src="currentImage.url" :alt="currentImage.alt">
            </div>
        </div>
    </div>
    <div class="tn-product-info" x-data>
        <p class="tn-product-info__category">{{ product.category.name }}</p>
        <h1>{{ product.name }}</h1>
        <div id="main-price-block">
            {% if bundleComponentsActive %}
                {% set packRangeLabel = bundlePriceRange and bundlePriceRange.label ? bundlePriceRange.label : product.price|number_format(2, ',', ' ') ~ ' €' %}
                <p class="tn-product-info__price"
                   x-text="totalPriceLabel() !== '—' ? totalPriceLabel() : '{{ packRangeLabel }}'"></p>
                {% if bundlePriceRange %}
                    <p class="text-sm text-slate-500" x-show="selections.length === 0">
                        Tarifs composants : {{ bundlePriceRange.label }}
                    </p>
                {% endif %}
            {% else %}
                {% if product.promoPrice %}
                    <div class="flex items-baseline gap-3">
                        <span class="line-through text-slate-400 text-xl" id="main-price-full">{{ product.price|number_format(2, ',', ' ') }} €</span>
                        <p class="tn-product-info__price text-red-600" id="main-price-promo">{{ product.promoPrice|number_format(2, ',', ' ') }} €</p>
                    </div>
                {% else %}
                    <p class="tn-product-info__price" id="main-price-full-only">{{ product.price|number_format(2, ',', ' ') }} €</p>
                {% endif %}
            {% endif %}
        </div>
        <p class="text-xs text-slate-500 mt-1"
           x-show="$store.variantState && $store.variantState.message"
           x-text="$store.variantState ? $store.variantState.message : ''"></p>
        <div class="mt-4 text-sm text-blue-600">
            {% if product.shop %}
                <span class="text-xs uppercase tracking-[0.3em] text-slate-400">Boutique</span>
                <a href="{{ path('shop_show', { slug: product.shop.slug }) }}" class="block font-semibold hover:underline">
                    {{ product.shop.name }}
                </a>
            {% endif %}
        </div>
        {% if product.shortDescription %}
            <p>{{ product.shortDescription }}</p>
        {% elseif product.description %}
            <div>{{ product.description|raw }}</div>
        {% endif %}
        {% if product.description %}
            <div class="tn-product-description rounded-2xl border border-slate-100 bg-white/80 p-6 shadow-sm ">
                <h3 class="underline decoration-solid text-xl font-semibold ">Description détaillée</h3>
                <div>{{ product.description|raw }}</div>
            </div>
        {% endif %}

        {% if variantData is not empty %}
            <div class="mt-6 space-y-4"
                 x-data="variantConfigurator($el.dataset.variants, $el.dataset.productStock)"
                 data-variants="{{ variantData|json_encode|e('html_attr') }}"
                 data-product-stock="{{ product.stock ?? 0 }}">
                <p class="block text-sm font-medium text-slate-600">Configure ton produit</p>
                <div class="grid gap-4 md:grid-cols-2">
                    <template x-for="attribute in attributeKeys" :key="attribute">
                        <div>
                            <label class="text-xs text-slate-500 uppercase tracking-[0.2em]" x-text="attribute"></label>
                            <select class="tn-select rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 w-full mt-1"
                                    x-model="selectedAttributes[attribute]"
                                    @change="onSelect(attribute)">
                                <option value="">Sélectionner</option>
                                <template x-for="value in (availableOptions[attribute] ?? [])" :key="value">
                                    <option :value="value" x-text="value"></option>
                                </template>
                            </select>
                        </div>
                    </template>
                </div>
                <div class="rounded-2xl border border-slate-100 bg-slate-50 px-4 py-3 text-sm"
                     x-show="currentVariant">
                    <div class="flex items-baseline gap-3">
                        <span class="font-semibold text-slate-900"
                              x-html="currentVariant ? currentVariant.priceHtml : ''"></span>
                        <span class="text-xs"
                              :class="currentVariant && currentVariant.promoPrice ? 'text-red-600' : 'text-slate-500'"
                              x-text="currentVariant ? currentVariant.stockText : ''"></span>
                    </div>
                </div>
                <p class="text-sm text-slate-500" x-show="warningMessage" x-text="warningMessage"></p>
            </div>
        {% endif %}

        {% if bundleComponentsActive %}
            <div class="mt-6 rounded-2xl border border-slate-100 bg-white p-5 shadow-sm space-y-4" x-cloak>
                <div class="flex items-center justify-between">
                    <h3 class="text-sm font-semibold text-slate-700">Produits sélectionnés</h3>
                    <span class="text-xs text-slate-500">
                        <span x-show="selections.length"
                              x-text="selections.length + ' composant' + (selections.length > 1 ? 's configurés' : ' configuré')"></span>
                        <span x-show="!selections.length">Aucun composant configuré.</span>
                    </span>
                </div>
                <template x-if="selections.length">
                    <div class="space-y-3 text-sm text-slate-700">
                        <template x-for="selection in selections" :key="selection.id">
                            <div class="flex items-center justify-between border-b border-slate-100 pb-3 last:border-b-0 last:pb-0">
                                <div>
                                    <p class="font-semibold" x-text="selection.name"></p>
                                    <p class="text-xs text-slate-500" x-text="selection.variantLabel"></p>
                                    <p class="text-xs text-slate-400" x-text="'Quantité : ' + selection.quantity"></p>
                                    <p class="text-xs text-slate-500"
                                       x-text="selection.stock > 0 ? selection.stock + ' en stock' : 'Rupture'"></p>
                                </div>
                                <div class="text-right space-y-1">
                                    <span class="text-slate-700 block" x-text="formatCurrency((selection.price || 0) * (selection.quantity || 1))"></span>
                                    <button type="button"
                                            class="text-xs text-red-500 hover:text-red-600"
                                            @click="removeSelection(selection.id)">
                                        Retirer
                                    </button>
                                </div>
                            </div>
                        </template>
                    </div>
                </template>
                <p class="text-xs text-slate-500" x-show="!selections.length">
                    {% if bundlePriceRange %}
                        Tarifs des composants : {{ bundlePriceRange.label }}.
                    {% else %}
                        Configurez les composants pour visualiser le tarif et le stock estimé.
                    {% endif %}
                </p>
                <div class="border-t border-slate-200 pt-3">
                    <p class="text-xs uppercase tracking-[0.3em] text-slate-400">Prix du pack</p>
                    <p class="text-lg font-semibold text-slate-900" x-text="totalPriceLabel()"></p>
                    <p class="text-xs text-slate-500"
                       x-show="discountPercent > 0"
                       x-text="'Remise pack : -' + discountPercentLabel() + ' (' + discountLabel() + ')'"></p>
                </div>
                <p class="text-xs text-red-500" x-show="selections.length && !canCheckout()">
                    Ajoute au moins deux configurations distinctes pour composer ton pack.
                </p>
            </div>
        {% endif %}

        {% if viewer %}
            <form class="tn-add-to-cart py-4"
                  method="post"
                  action="{{ path('app_cart_add', {id: product.id}) }}"
                  x-data
                  x-effect="$refs.variantIdField && ($refs.variantIdField.value = $store.variantState.variantId ?? '')">
                {% if not bundleComponentsActive %}
                    <label class="sr-only" for="quantity">Quantité</label>
                    <input class="tn-input"
                           x-ref="quantityField"
                           id="quantity"
                           name="quantity"
                           type="number"
                           min="1"
                           :max="$store.variantState.stock ?? {{ product.stock ?? 0 }}"
                           value="1"
                           :disabled="$store.variantState && $store.variantState.needsSelection && !$store.variantState.ready"
                           x-on:input="const max = Number($store.variantState.stock ?? {{ product.stock ?? 0 }}); if ($event.target.value > max) { $event.target.value = max; } if ($event.target.value < 1) { $event.target.value = 1; }"
                           x-effect="const max = Number($store.variantState.stock ?? {{ product.stock ?? 0 }}); if (Number($refs.quantityField.value) > max) { $refs.quantityField.value = max; }">
                {% else %}
                    <input type="hidden" name="quantity" value="1">
                    <input type="hidden" name="bundle_selections" x-bind:value="JSON.stringify(selections)">
                {% endif %}
                <input type="hidden"
                       name="variant_id"
                       x-ref="variantIdField"
                       :value="$store.variantState.variantId ?? ''">
                <input type="hidden" name="redirect_to" value="product">
                <input type="hidden" name="product_slug" value="{{ product.slug }}">
                <input type="hidden" name="_token" value="{{ csrf_token('add_to_cart_' ~ product.id) }}">
                <button class="btn btn-primary" type="submit"
                        {% if bundleComponentsActive %}
                        :class="{'cursor-not-allowed opacity-40': !canCheckout()}"
                        :disabled="!canCheckout()"
                        {% else %}
                        :class="{'cursor-not-allowed opacity-40': $store.variantState && $store.variantState.needsSelection && !$store.variantState.ready}"
                        :disabled="$store.variantState && $store.variantState.needsSelection && !$store.variantState.ready"
                        {% endif %}>
                    Ajouter au panier
                </button>
            </form>
            {% if bundleComponentsActive %}
                <p class="text-xs text-red-500"
                   x-show="selections.length && !canCheckout()">
                    Sélectionne au moins deux configurations différentes pour profiter du pack.
                </p>
            {% else %}
                <p class="text-xs text-red-500"
                   x-show="$store.variantState && $store.variantState.needsSelection && !$store.variantState.ready">
                    Sélectionne une configuration complète pour continuer.
                </p>
            {% endif %}
        {% else %}
            <p class="text-slate-600">Connectez-vous pour ajouter ce produit au panier.</p>
            <a class="btn btn-outline" href="{{ path('app_login') }}">Connexion</a>
        {% endif %}
        <div class="tn-product-meta">
            <div>
                <strong>Marque</strong>
                <p>{{ product.brand ? product.brand.name : 'TechNova' }}</p>
            </div>
            <div>
                <strong>Stock</strong>
                <p id="main-stock">{{ product.stock > 0 ? product.stock ~ ' disponibles' : 'Rupture' }}</p>
            </div>
        </div>
        {% if can_edit %}
            <div class="mt-4">
                <a href="{{ path('app_vendor_product_edit', {id: product.id}) }}" class="btn btn-outline">
                    Modifier ce produit
                </a>
            </div>
        {% endif %}
    </div>
</section>

{% if bundleComponentsActive %}
    <section class="tn-section">
        <div class="tn-section__header">
            <h2>Configure ton pack</h2>
            <p class="text-sm text-slate-500">
                Choisis la configuration de chaque composant proposé par le commerçant pour visualiser le prix total.
            </p>
        </div>
        <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
            <template x-for="component in components" :key="component.id">
                <div class="rounded-2xl border border-slate-100 bg-white p-4 shadow-sm space-y-3">
                    <div class="flex items-center justify-between">
                        <p class="text-xs uppercase tracking-[0.3em] text-slate-400" x-text="component.typeLabel"></p>
                        <span class="text-xs font-semibold text-slate-500"
                              x-text="component.stock ? component.stock + ' en stock' : 'Rupture'"></span>
                    </div>
                    <h3 class="text-lg font-semibold text-slate-900" x-text="component.name"></h3>
                    <p class="text-sm text-slate-500" x-text="component.priceRange?.label ?? '—'"></p>
                    <div class="flex items-center justify-between">
                        <button type="button"
                                class="btn btn-outline btn-sm"
                                @click="openConfiguration(component.id)">
                            Configurer
                        </button>
                        <div class="flex flex-col items-end gap-1 text-xs text-slate-400" x-show="selectionCount(component.id) > 0">
                            <span x-text="selectionCount(component.id) + ' configuration' + (selectionCount(component.id) > 1 ? 's' : '')"></span>
                            <button type="button"
                                    class="text-red-500 hover:text-red-600"
                                    @click="clearSelectionsForComponent(component.id)">
                                Supprimer toutes
                            </button>
                        </div>
                    </div>
                </div>
            </template>
        </div>
        
        <div x-cloak x-show="modalOpen" class="fixed inset-0 z-50 flex items-center justify-center px-4">
            <div class="absolute inset-0 bg-slate-900/60" @click="closeModal()"></div>
            <div class="relative w-full max-w-lg rounded-3xl bg-white p-6 space-y-4 shadow-2xl max-h-[90vh] overflow-y-auto"
                 style="max-height: 90vh; overflow-y: auto;">
                <div>
                    <p class="text-xs uppercase tracking-[0.3em] text-slate-400" x-text="activeComponent ? activeComponent.typeLabel : ''"></p>
                    <h3 class="text-2xl font-semibold text-slate-900" x-text="activeComponent ? activeComponent.name : ''"></h3>
                </div>
                <div class="rounded-2xl border border-slate-100 bg-slate-50 p-4 text-sm text-slate-500" x-cloak x-show="modalLoading">
                    Chargement de la fiche produit…
                </div>
                <div class="space-y-3" x-cloak x-show="modalHtml" x-html="modalHtml"></div>
                <div class="space-y-3" x-show="attributeKeys.length">
                    <template x-for="attribute in attributeKeys" :key="attribute">
                        <div>
                            <p class="text-xs font-semibold uppercase tracking-[0.3em] text-slate-400" x-text="attribute"></p>
                            <select class="tn-select w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 mt-1"
                                    x-model="selectedAttributes[attribute]"
                                    @change="onAttributeChange(attribute)">
                                <option value="">Sélectionner</option>
                                <template x-for="option in availableOptions[attribute]" :key="option">
                                    <option :value="option" x-text="option"></option>
                                </template>
                            </select>
                        </div>
                    </template>
                </div>
                <div class="rounded-2xl border border-slate-200 bg-white p-4 text-sm">
                    <div class="flex items-center justify-between">
                        <span class="text-xs uppercase tracking-[0.3em] text-slate-400">Prix</span>
                        <div class="text-right">
                            <template x-if="currentVariantReady() && activeVariantPromoPrice()">
                                <div class="flex items-baseline gap-2">
                                    <span class="line-through text-sm text-slate-400" x-text="formatCurrency(activeVariantBasePrice())"></span>
                                    <span class="text-lg font-semibold text-red-600" x-text="formatCurrency(activeVariantPromoPrice())"></span>
                                </div>
                            </template>
                            <template x-if="currentVariantReady() && !activeVariantPromoPrice()">
                                <span class="text-lg font-semibold text-slate-900" x-text="formatCurrency(activeVariantPrice())"></span>
                            </template>
                            <template x-if="!currentVariantReady()">
                                <span class="text-sm text-slate-500" x-text="activeComponent ? (activeComponent.priceRange?.label ?? '—') : '—'"></span>
                            </template>
                        </div>
                    </div>
                    <div class="flex items-center justify-between mt-2">
                        <span class="text-xs uppercase tracking-[0.3em] text-slate-400">Stock</span>
                        <span class="text-lg font-semibold text-slate-900" x-text="activeVariantStockText()"></span>
                    </div>
                </div>
                <div>
                    <label class="text-sm font-medium text-slate-600">Quantité</label>
                    <input class="tn-input w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 mt-1"
                           type="number"
                           min="1"
                           step="1"
                           x-model.number="activeQuantity">
                </div>
                <div class="flex items-center justify-end gap-3">
                    <button type="button" class="btn btn-outline" @click="closeModal()">Annuler</button>
                    <button type="button"
                            class="btn btn-primary"
                            :disabled="!currentVariantReady()"
                            @click="confirmSelection()">
                        Ajouter au pack
                    </button>
                </div>
                <p class="text-xs text-red-500 text-right"
                   x-show="!currentVariantReady()">
                    Choisis la configuration souhaitée pour ajouter ce composant au pack.
                </p>
            </div>
        </div>
    </section>
{% endif %}

{% if bundleComponentsActive %}
    </div>
{% endif %}

{# Caractéristiques synthétiques pour rappeler les points forts #}
<section class="tn-section">
    <div class="tn-section__header">
        <h2>Caractéristiques du produit</h2>
    </div>
    <div class="tn-product-specs">
        <ul>
            {% for label, value in specifications %}
                <li>
                    <strong>{{ label }}</strong><br>
                    {{ value }}
                </li>
            {% endfor %}
        </ul>
    </div>
</section>

{% if optionGroups is not empty %}
    <section class="tn-section">
        <div class="tn-section__header">
            <h2>Caractéristiques disponibles</h2>
        </div>
        <div class="grid gap-4 md:grid-cols-2 tn-options">
            {% for group in optionGroups %}
                <div class="rounded-2xl border border-slate-100 bg-white/80 p-4 shadow-sm">
                    <p class="text-xs uppercase tracking-[0.25em] text-slate-400 mb-1">{{ group.name }}</p>
                    <div class="flex flex-wrap gap-2">
                        {% for value in group.values %}
                            <span class="inline-flex items-center rounded-full border border-slate-200 bg-slate-50 px-3 py-1 text-xs font-semibold text-slate-700">
                                {{ value.label }}
                            </span>
                        {% endfor %}
                    </div>
                </div>
            {% endfor %}
        </div>
    </section>
{% endif %}


{# Avis clients #}
<section class="tn-section">
    <div class="tn-section__header">
        <h2>Avis clients</h2>
    </div>
    <div class="mb-4 flex items-center gap-3">
        {{ include('partials/_rating_display.html.twig', {
            rating: review_stats.avg,
            size: 'xl'
        }) }}
        <span class="text-sm text-slate-600">
            {{ review_stats.avg|number_format(1, ',', ' ') }}/5 ({{ review_stats.count }} avis)
        </span>
    </div>

    <div class="tn-reviews">
        {% if approved_reviews|length > 0 %}
            {% for review in approved_reviews %}
                <article>
                    <div class="flex items-center gap-2">
                        {{ include('partials/_rating_display.html.twig', {
                            rating: review.rating,
                            size: 'lg'
                        }) }}
                        <span class="text-sm text-slate-600">
                            {{ review.rating|number_format(1, ',', ' ') }}/5
                        </span>
                    </div>

                    <div>{{ review.comment|raw }}</div>
                    <p class="text-xs text-slate-400 mt-2">{{ review.createdAt|date('d/m/Y') }}</p>
                </article>
            {% endfor %}
        {% else %}
            <p>Aucun avis pour le moment.</p>
        {% endif %}
    </div>
</section>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
{% endblock %}
