{% extends 'base.html.twig' %}

{% block title %}Catalogue | TechNova{% endblock %}

{% block body %}
{# Entête catalogue : champs de recherche/tri #}
<section class="tn-section">
    <h1>Catalogue produits</h1>
        <form class="tn-filters" method="get" action="{{ path('catalog_index') }}">
            <input type="hidden" name="page" value="{{ pagination.page }}">
            <div class="relative max-w-xs w-full">
                <input type="text" name="search" value="{{ activeFilters.search }}" placeholder="Rechercher un produit…" onkeydown="if (event.key === 'Enter') { this.form.requestSubmit(); }" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false">
                <div class="tn-search-suggestions hidden" data-search-suggestions></div>
            </div>
        <div class="tn-select">
            <select name="category" onchange="this.form.requestSubmit()">
                <option value="">Toutes les catégories</option>
                {% for category in categories %}
                    <option value="{{ category.slug }}" {{ activeFilters.category == category.slug ? 'selected' }}>{{ category.name }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="tn-select">
            <select name="brand" onchange="this.form.requestSubmit()">
                <option value="">Toutes les marques</option>
                {% for brand in brands %}
                    <option value="{{ brand.slug }}" {{ activeFilters.brand == brand.slug ? 'selected' }}>{{ brand.name }}</option>
                {% endfor %}
            </select>
        </div>
        <input type="number" name="minPrice" value="{{ activeFilters.minPrice }}" min="0" step="50" placeholder="Prix min (€)" onkeydown="if (event.key === 'Enter') { this.form.requestSubmit(); }">
        <input type="number" name="maxPrice" value="{{ activeFilters.maxPrice }}" min="0" step="50" placeholder="Prix max (€)" onkeydown="if (event.key === 'Enter') { this.form.requestSubmit(); }">
        <div class="tn-select">
            <select name="sort" onchange="this.form.requestSubmit()">
                <option value="newest" {{ activeFilters.sort == 'newest' or not activeFilters.sort ? 'selected' }}>Plus récents</option>
                <option value="oldest" {{ activeFilters.sort == 'oldest' ? 'selected' }}>Plus anciens</option>
                <option value="price_asc" {{ activeFilters.sort == 'price_asc' ? 'selected' }}>Prix croissant</option>
                <option value="price_desc" {{ activeFilters.sort == 'price_desc' ? 'selected' }}>Prix décroissant</option>
            </select>
        </div>
        <div class="tn-select">
            <label class="sr-only" for="catalog-rows">Lignes par page</label>
            <select id="catalog-rows" name="rows">
                {% for option in rows_options %}
                    <option value="{{ option }}" {{ selected_rows == option ? 'selected' : '' }}>{{ option }} lignes</option>
                {% endfor %}
            </select>
        </div>
        <input type="hidden" name="limit" value="{{ pagination.per_page }}">
        <button type="submit" class="btn btn-primary">Filtrer</button>
        <a class="btn btn-outline" href="{{ path('catalog_index') }}">Réinitialiser</a>
    </form>
</section>

{# Grille principale du catalogue #}
<section class="tn-section">
    <div class="tn-section__header">
        <h2>{{ resultsCount }} produit{{ resultsCount > 1 ? 's' }}</h2>
    </div>
    <div class="tn-products-grid">
        {% for product in products %}
            <article class="tn-product-card tn-product-card--compact">
                {% set mainImage = product.images|first %}
                <div class="tn-product-card__media">
                    <img
                        src="{{ mainImage ? mainImage.url : asset('assets/images/product-placeholder.svg') }}"
                        alt="{{ mainImage ? mainImage.alt : 'Visuel par défaut' }}"
                    >
                </div>

                <h3 class="min-w-0 text-[1.05rem] font-semibold leading-tight" title="{{ product.name }}">
                    {{ product.name }}
                </h3>

                <p class="tn-product-card__excerpt line-clamp-2 leading-relaxed min-h-[3.2em]">{{ product.shortDescription }}</p>
                {% set reviewSummary = review_summaries[product.id] ?? null %}
                {% set avgRating = reviewSummary ? reviewSummary.avg : 0 %}
                {% set reviewCount = reviewSummary ? reviewSummary.count : 0 %}
                <div class="flex items-center gap-2">
                    {{ include('partials/_rating_display.html.twig', { rating: avgRating }) }}
                    <span class="tn-rating__count">({{ reviewCount }})</span>
                </div>

                <div class="tn-product-card__meta">
                    <span>{{ product.brand ? product.brand.name : product.shop.name }}</span>
                    <strong>{{ product.price|number_format(2, ',', ' ') }} €</strong>
                </div>
                <div class="mt-2 text-xs text-blue-600">
                    <a href="{{ path('shop_show', { slug: product.shop.slug }) }}" class="hover:underline">Boutique {{ product.shop.name }}</a>
                </div>

                <div class="tn-product-card__cta mt-auto">
                    <a class="btn btn-primary" href="{{ path('product_show', {slug: product.slug}) }}">Voir le produit</a>
                </div>
            </article>

        {% else %}
            <p>Aucun produit ne correspond à votre recherche.</p>
        {% endfor %}
    </div>
    {% if pagination.pages > 1 %}
        {% set base_query = app.request.query.all %}
        <div class="tn-pagination">
            <p>{{ pagination.total }} produit{{ pagination.total > 1 ? 's' : '' }} — page {{ pagination.page }} sur {{ pagination.pages }}</p>
            <div class="tn-pagination__actions">
                <a class="tn-pagination__link {% if pagination.page <= 1 %}tn-pagination__link--disabled{% endif %}"
                   href="{{ path('catalog_index', base_query|merge({'page': pagination.page - 1})) }}">Précédent</a>
                <a class="tn-pagination__link {% if pagination.page >= pagination.pages %}tn-pagination__link--disabled{% endif %}"
                   href="{{ path('catalog_index', base_query|merge({'page': pagination.page + 1})) }}">Suivant</a>
            </div>
        </div>
    {% endif %}
</section>
{% endblock %}
