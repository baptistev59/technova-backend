{% extends 'vendor/layout.html.twig' %}

{% set STATUS_PENDING = constant('App\\Enum\\OrderStatus::Pending').value %}
{% set STATUS_PAID = constant('App\\Enum\\OrderStatus::Paid').value %}
{% set STATUS_SHIPPED = constant('App\\Enum\\OrderStatus::Shipped').value %}
{% set STATUS_CANCELLED = constant('App\\Enum\\OrderStatus::Cancelled').value %}

{% block title %}Commandes — {{ shop.name }}{% endblock %}

{% block vendor_content %}
    <header class="space-y-2">
        <p class="text-xs font-semibold tracking-[0.35em] text-slate-400 uppercase">Technova</p>
        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
            <div>
                <h1 class="text-3xl md:text-4xl font-semibold text-slate-900">Commandes</h1>
                <p class="text-slate-500 mt-2">Suis les commandes associées à ta boutique et leurs statuts.</p>
            </div>
        </div>
    </header>

    <section class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
        <div class="rounded-3xl border border-slate-100 bg-white p-5 shadow-sm">
            <p class="text-xs uppercase tracking-[0.3em] text-slate-400">Commandes totales</p>
            <p class="mt-2 text-3xl font-semibold text-slate-900">{{ metrics.totalOrders }}</p>
        </div>
        <div class="rounded-3xl border border-slate-100 bg-white p-5 shadow-sm">
            <p class="text-xs uppercase tracking-[0.3em] text-slate-400">En attente</p>
            <p class="mt-2 text-3xl font-semibold text-amber-600">{{ metrics.pendingOrders }}</p>
        </div>
        <div class="rounded-3xl border border-slate-100 bg-white p-5 shadow-sm">
            <p class="text-xs uppercase tracking-[0.3em] text-slate-400">Payées</p>
            <p class="mt-2 text-3xl font-semibold text-emerald-600">{{ metrics.paidOrders }}</p>
        </div>
        <div class="rounded-3xl border border-slate-100 bg-white p-5 shadow-sm">
            <p class="text-xs uppercase tracking-[0.3em] text-slate-400">Revenus cumulés</p>
            <p class="mt-2 text-3xl font-semibold text-slate-900">{{ metrics.revenue|number_format(2, ',', ' ') }} €</p>
        </div>
    </section>

    <section class="mt-6 rounded-3xl border border-slate-100 bg-white p-6 shadow-sm">
        <form method="get" class="grid gap-4 md:grid-cols-2" autocomplete="off">
            <div class="space-y-2">
                <label for="order-status-filter" class="text-xs uppercase tracking-[0.3em] text-slate-400">Filtrer par statut</label>
                <div class="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3">
                    <select id="order-status-filter"
                            name="status"
                            class="tn-select w-full bg-transparent focus:outline-none"
                            onchange="this.form.submit()">
                        <option value="" {{ (status_filter ?? null) is null ? 'selected' : '' }}>Tous les statuts</option>
                        {% for code, badge in status_badges %}
                            <option value="{{ code }}" {{ (status_filter ?? null) == code ? 'selected' : '' }}>{{ badge.label }}</option>
                        {% endfor %}
                    </select>
                </div>
            </div>
            <div class="space-y-2">
                <label for="order-limit" class="text-xs uppercase tracking-[0.3em] text-slate-400">Nombre de commandes par page</label>
                <div class="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3">
                    <select id="order-limit"
                            name="limit"
                            class="tn-select w-full bg-transparent focus:outline-none"
                            onchange="this.form.submit()">
                        {% for option in per_page_options ?? [10, 25, 50] %}
                            <option value="{{ option }}" {{ (per_page ?? 10) == option ? 'selected' : '' }}>
                                {{ option }} / page
                            </option>
                        {% endfor %}
                    </select>
                </div>
            </div>
            <input type="hidden" name="page" value="1">
            <noscript>
                <button class="btn btn-outline" type="submit">Mettre à jour</button>
            </noscript>
        </form>
    </section>

    {% if orders is empty %}
        <div class="rounded-3xl border border-dashed border-slate-200 bg-white p-10 text-center text-slate-500">
            <p class="text-lg font-medium text-slate-700">Aucune commande pour le moment</p>
            <p class="mt-2">Tes commandes apparaîtront ici dès qu’un client aura validé un panier.</p>
        </div>
    {% else %}
        <div class="space-y-4">
            {% for entry in orders %}
                {% set order = entry.entity %}
                {% set status_code = order.status.value ?? order.status %}
                {% set badge = status_badges[status_code] ?? { label: status_code, class: 'bg-slate-100 text-slate-600 border border-slate-200' } %}
                <details class="group rounded-3xl border border-slate-100 bg-white shadow-sm">
                    <summary class="flex cursor-pointer list-none flex-col gap-4 px-6 py-4 md:flex-row md:items-center md:justify-between">
                        <div>
                            <p class="text-xs uppercase tracking-[0.3em] text-slate-400">Commande</p>
                            <h3 class="text-xl font-semibold text-slate-900">{{ order.reference }}</h3>
                            <p class="text-xs text-slate-500">Passée le {{ order.createdAt ? order.createdAt|date('d/m/Y H:i') : '—' }}</p>
                        </div>
                        <div class="flex flex-col items-end gap-2 text-right">
                            <div class="flex items-center gap-3">
                                <span class="inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold {{ badge.class }}">
                                    {{ badge.label }}
                                </span>
                                <svg class="h-4 w-4 text-slate-400 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                    <path d="M19 9l-7 7-7-7" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                            </div>
                            <p class="text-xs uppercase tracking-[0.3em] text-slate-400">Montant pour ton shop</p>
                            <p class="text-xl font-semibold text-slate-900">{{ entry.lineTotal|number_format(2, ',', ' ') }} €</p>
                        </div>
                    </summary>
                    <div class="border-t border-slate-100 px-6 py-5 space-y-4">
                        <div class="flex flex-col gap-2 md:flex-row md:items-center md:justify-between">
                            <p class="text-sm text-slate-500">
                                {% if entry.customer %}
                                    Client&nbsp;: <span class="font-medium text-slate-700">{{ entry.customer }}</span>
                                {% else %}
                                    Client inconnu
                                {% endif %}
                            </p>
                        <div class="flex flex-wrap items-center gap-2">
                            {% if status_code == STATUS_PENDING %}
                                    <form method="post"
                                          action="{{ path('app_vendor_orders_update', {id: order.id}) }}"
                                          onsubmit="return confirm('Marquer cette commande comme payée ?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('vendor_order_status_' ~ order.id) }}">
                                        <input type="hidden" name="status" value="{{ STATUS_PAID }}">
                                        <button class="btn btn-outline btn-sm" type="submit">Marquer payée</button>
                                    </form>
                                    <form method="post" action="{{ path('app_vendor_orders_update', {id: order.id}) }}" onsubmit="return confirm('Annuler cette commande ?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('vendor_order_status_' ~ order.id) }}">
                                        <input type="hidden" name="status" value="{{ STATUS_CANCELLED }}">
                                        <button class="btn btn-outline btn-sm text-red-600 border-red-200" type="submit">Annuler</button>
                                    </form>
                            {% elseif status_code == STATUS_PAID %}
                                    <form method="post"
                                          action="{{ path('app_vendor_orders_update', {id: order.id}) }}"
                                          onsubmit="return confirm('Marquer cette commande comme expédiée ?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('vendor_order_status_' ~ order.id) }}">
                                        <input type="hidden" name="status" value="{{ STATUS_SHIPPED }}">
                                        <button class="btn btn-outline btn-sm" type="submit">Marquer expédiée</button>
                                    </form>
                                <form method="post" action="{{ path('app_vendor_orders_update', {id: order.id}) }}" onsubmit="return confirm('Annuler cette commande ?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('vendor_order_status_' ~ order.id) }}">
                                    <input type="hidden" name="status" value="{{ STATUS_CANCELLED }}">
                                    <button class="btn btn-outline btn-sm text-red-600 border-red-200" type="submit">Annuler</button>
                                </form>
                            {% endif %}
                            <button
                                type="button"
                                class="btn btn-link btn-sm"
                                data-order-doc
                                data-order-id="{{ order.id }}"
                                data-type="delivery"
                            >
                                Bon de livraison
                            </button>
                        </div>
                        </div>
                        <div>
                            <p class="text-xs uppercase tracking-[0.25em] text-slate-400 mb-2">Articles vendus</p>
                            <div class="space-y-2">
                                {% for line in entry.lines %}
                                    <div class="flex items-center justify-between text-sm text-slate-600">
                                        <div>
                                            <p class="font-medium text-slate-900">{{ line.name }}</p>
                                            <p class="text-xs text-slate-500">Quantité : {{ line.quantity }}</p>
                                        </div>
                                        <p class="font-semibold text-slate-900">{{ line.lineTotal|number_format(2, ',', ' ') }} €</p>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                    <div class="rounded-2xl border border-dashed border-slate-200 bg-slate-50 p-4 space-y-3">
                        <h3 class="text-sm font-semibold text-slate-900">Messagerie commande</h3>
                        <div class="tn-conversation-panel" data-order-id="{{ order.id }}" data-api-base="/api/vendor/conversations">
                            <div class="space-y-2 max-h-40 overflow-y-auto" data-conversation-messages>
                                <p class="text-sm text-slate-400">Chargement…</p>
                            </div>
                            <form class="space-y-2" data-conversation-form>
                                <textarea name="content" rows="2" class="tn-textarea w-full resize-none" placeholder="Répondre au client…" data-trix="true" required></textarea>
                                <div class="flex items-center justify-between">
                                    <p class="text-xs text-red-500" data-conversation-status></p>
                                    <button class="btn btn-primary btn-sm" type="submit">Envoyer</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </details>
            {% endfor %}
        </div>

        {% if pagination.pages > 1 %}
            {% set prev = pagination.page - 1 %}
            {% set next = pagination.page + 1 %}
            <div class="flex flex-wrap items-center justify-between rounded-3xl border border-slate-100 bg-white p-4 mt-6">
                <p class="text-sm text-slate-500">
                    Page {{ pagination.page }} sur {{ pagination.pages }} — {{ pagination.total }} commande{{ pagination.total > 1 ? 's' : '' }}
                </p>
                <div class="flex gap-2">
                    <a href="{{ path('app_vendor_orders', app.request.query.all|merge({'page': 1})) }}"
                       class="btn btn-outline btn-sm {{ pagination.page == 1 ? 'pointer-events-none opacity-50' : '' }}">Début</a>
                    <a href="{{ path('app_vendor_orders', app.request.query.all|merge({'page': prev < 1 ? 1 : prev})) }}"
                       class="btn btn-outline btn-sm {{ pagination.page == 1 ? 'pointer-events-none opacity-50' : '' }}">Préc.</a>
                    <a href="{{ path('app_vendor_orders', app.request.query.all|merge({'page': next > pagination.pages ? pagination.pages : next})) }}"
                       class="btn btn-outline btn-sm {{ pagination.page == pagination.pages ? 'pointer-events-none opacity-50' : '' }}">Suiv.</a>
                    <a href="{{ path('app_vendor_orders', app.request.query.all|merge({'page': pagination.pages})) }}"
                       class="btn btn-outline btn-sm {{ pagination.page == pagination.pages ? 'pointer-events-none opacity-50' : '' }}">Fin</a>
                </div>
            </div>
        {% endif %}
    {% endif %}
{% endblock %}
