{% extends 'vendor/layout.html.twig' %}

{% block title %}Mes produits — {{ shop.name }}{% endblock %}

{% set has_filters = filters.search or filters.category or filters.brand or filters.stock or filters.type or filters.status %}

{% block vendor_content %}
    <div class="space-y-8" x-data="mesProduitsState({{ product_ids|json_encode }})">
        <header class="space-y-2">
            <p class="text-xs font-semibold tracking-[0.35em] text-slate-400 uppercase">Technova</p>
            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
                <div>
                    <h1 class="text-3xl md:text-4xl font-semibold text-slate-900">Mes produits</h1>
                    <p class="text-slate-500 mt-2">Gère ton catalogue, crée de nouveaux articles et suis leur publication.</p>
                </div>
                <a href="{{ path('app_vendor_product_new') }}" class="btn btn-primary shrink-0">Ajouter un produit</a>
            </div>
        </header>

        <section class="rounded-3xl border border-slate-100 bg-white p-6 shadow-sm space-y-6">
            <form method="get" class="space-y-4" autocomplete="off">
                <div class="flex flex-col gap-3 md:flex-row md:items-center md:gap-4">
                    <div class="relative flex-1">
                        <input type="search"
                               name="q"
                               value="{{ filters.search }}"
                               placeholder="Rechercher par nom, UGS…"
                               class="tn-input rounded-2xl border border-slate-200 bg-slate-50 pl-12 pr-4 py-3 w-full">
                        <span class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-400">🔍</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <button type="submit" class="btn btn-outline">Filtrer</button>
                        {% if has_filters %}
                            <a href="{{ path('app_vendor_products') }}" class="text-sm text-slate-500 hover:text-slate-900">Réinitialiser</a>
                        {% endif %}
                    </div>
                </div>
                <div class="grid gap-3 md:grid-cols-3 xl:grid-cols-6">
                    <select name="category" class="tn-select rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3" onchange="this.form.submit()">
                        <option value="">Catégorie</option>
                        {% for category in categories %}
                            <option value="{{ category.slug }}" {{ filters.category == category.slug ? 'selected' : '' }}>{{ category.name }}</option>
                        {% endfor %}
                    </select>
                    <select name="brand" class="tn-select rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3" onchange="this.form.submit()">
                        <option value="">Marque</option>
                        {% for brand in brands %}
                            <option value="{{ brand.slug }}" {{ filters.brand == brand.slug ? 'selected' : '' }}>{{ brand.name }}</option>
                        {% endfor %}
                    </select>
                    <select name="stock" class="tn-select rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3" onchange="this.form.submit()">
                        <option value="">Stock</option>
                        {% for key, label in stock_filters %}
                            <option value="{{ key }}" {{ filters.stock == key ? 'selected' : '' }}>{{ label }}</option>
                        {% endfor %}
                    </select>
                    <select name="type" class="tn-select rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3" onchange="this.form.submit()">
                        <option value="">Type</option>
                        {% for key, label in product_types %}
                            <option value="{{ key }}" {{ filters.type == key ? 'selected' : '' }}>{{ label }}</option>
                        {% endfor %}
                    </select>
                    <select name="status" class="tn-select rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3" onchange="this.form.submit()">
                        <option value="" {{ filters.status is not same as(null) and filters.status != '' ? '' : 'selected' }}>Statut</option>
                        {% for key, label in status_filters %}
                            <option value="{{ key }}" {{ filters.status is same as(key) ? 'selected' : '' }}>{{ label }}</option>
                        {% endfor %}
                    </select>
                    <select name="sort" class="tn-select rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3" onchange="this.form.submit()">
                        {% for key, label in sort_options %}
                            <option value="{{ key }}" {{ current_sort == key ? 'selected' : '' }}>{{ label }}</option>
                        {% endfor %}
                    </select>
                </div>
            </form>

            <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
                <p class="text-sm text-slate-500">{{ pagination.total }} produit(s) trouvé(s)</p>
                <div class="flex flex-wrap gap-2" x-show="selectedIds.length > 0" x-cloak>
                    <div class="text-sm text-slate-600 bg-slate-100 rounded-full px-3 py-1">
                        <strong x-text="selectedIds.length"></strong> sélectionné(s)
                    </div>
                    <div class="flex flex-wrap gap-2">
                        <button type="button" class="btn btn-outline btn-sm" title="Publier">Publier</button>
                        <button type="button" class="btn btn-outline btn-sm" title="Dépublier">Dépublier</button>
                        <button type="button" class="btn btn-outline btn-sm" title="Dupliquer">Dupliquer</button>
                        <button type="button" class="btn btn-outline btn-sm text-red-600 border-red-200 hover:bg-red-50" title="Supprimer">Supprimer</button>
                    </div>
                </div>
            </div>

            {% if products is empty %}
                <div class="text-center py-20 border border-dashed border-slate-200 rounded-3xl bg-slate-50">
                    <p class="text-lg font-semibold text-slate-900 mb-2">Tu n’as pas encore de produit.</p>
                    <p class="text-slate-500 mb-6">Ajoute ton premier article pour remplir ton catalogue.</p>
                    <a href="{{ path('app_vendor_product_new') }}" class="btn btn-primary">Créer mon premier produit</a>
                </div>
            {% else %}
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-slate-100">
                        <thead class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-400">
                            <tr>
                                <th class="py-3 px-2">
                                    <input type="checkbox" class="tn-checkbox" @change="toggleAll($event)" :checked="allSelected">
                                </th>
                                <th class="py-3 px-4 text-left">Produit</th>
                                <th class="py-3 px-4 text-left">Catégorie</th>
                                <th class="py-3 px-4 text-left" style="width:1%; white-space: nowrap;">Prix</th>
                                <th class="py-3 px-4 text-left" style="width:1%; white-space: nowrap;">Stock</th>
                                <th class="py-3 px-4 text-left">Type</th>
                                <th class="py-3 px-4 text-left">Mise à jour</th>
                                <th class="py-3 px-4 text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 text-sm text-slate-600">
                            {% for product in products %}
                                {% set mainImage = product.images|filter(image => image.isMain)|first %}
                                {% if mainImage is null and product.images|length > 0 %}
                                    {% set mainImage = product.images|first %}
                                {% endif %}
                                {% set promoPrice = product.promoPrice %}
                                {% set typeLabel = product_types[product.type|default('')] ?? 'Produit simple' %}
                                <tr class="hover:bg-slate-50 transition">
                                    <td class="py-4 px-2 align-top">
                                        <input type="checkbox"
                                               class="tn-checkbox"
                                               value="{{ product.id }}"
                                               x-model="selectedIds">
                                    </td>
                                    <td class="py-4 px-4">
                                        <div class="flex gap-3">
                                            <div class="h-16 w-16 rounded-2xl border border-slate-200 bg-slate-100 overflow-hidden flex-shrink-0">
                                                {% if mainImage %}
                                                    <a href="{{ path('product_show', { slug: product.slug, shop: shop.id }) }}" target="_blank" rel="noopener" class="block h-full w-full">
                                                        <img src="{{ asset(mainImage.url) }}" alt="{{ product.name }}" class="object-cover h-full w-full">
                                                    </a>
                                                {% else %}
                                                    <div class="h-full w-full flex items-center justify-center text-slate-400 text-xs">Aucune image</div>
                                                {% endif %}
                                            </div>
                                            <div>
                                                <p class="font-semibold text-slate-900">
                                                    <a href="{{ path('product_show', { slug: product.slug, shop: shop.id }) }}" target="_blank" rel="noopener" class="hover:underline">
                                                        {{ product.name }}
                                                    </a>
                                                </p>
                                                <p class="text-xs text-slate-500">Marque : {{ product.brand ? product.brand.name : '—' }}</p>
                                                <p class="text-xs text-slate-400">UGS : {{ product.sku ?? '—' }}</p>
                                                {% if product.isPublished %}
                                                    <span class="inline-flex items-center gap-1 text-xs text-green-600 mt-1">● Publié</span>
                                                {% else %}
                                                    <span class="inline-flex items-center gap-1 text-xs text-amber-600 mt-1">● Brouillon</span>
                                                {% endif %}
                                            </div>
                                        </div>
                                    </td>
                                    <td class="py-4 px-4 align-top">
                                        {{ product.category ? product.category.name : '—' }}
                                    </td>
                                    <td class="py-4 px-4 align-top" style="width:1%; white-space: nowrap;">
                                        {% set variantCount = product.variants|length %}
                                        {% if variantCount > 0 and product.type == 'variable' %}
                                            {% set prices = [] %}
                                            {% for variant in product.variants %}
                                                {% set effective = variant.promoPrice ?? variant.price %}
                                                {% if effective is not null %}
                                                    {% set prices = prices|merge([effective]) %}
                                                {% endif %}
                                            {% endfor %}
                                            {% if prices is not empty %}
                                                {% set sortedPrices = prices|sort %}
                                                {% set minPrice = sortedPrices|first %}
                                                {% set maxPrice = sortedPrices|last %}
                                                <div class="flex flex-col whitespace-nowrap">
                                                    <span class="font-semibold text-slate-900">{{ minPrice|number_format(2, ',', ' ') }} €</span>
                                                    <span class="text-xs text-slate-500">Prix min</span>
                                                    <span class="font-semibold text-slate-900 mt-2">{{ maxPrice|number_format(2, ',', ' ') }} €</span>
                                                    <span class="text-xs text-slate-500">Prix max</span>
                                                </div>
                                            {% else %}
                                                <span class="text-sm text-slate-500">—</span>
                                            {% endif %}
                                        {% elseif product.type == 'grouped' %}
                                            {% set bundlePrices = [] %}
                                            {% for item in product.bundleItems %}
                                                {% if item.component %}
                                                    {% if item.component.variants|length > 0 %}
                                                        {% for variant in item.component.variants %}
                                                            {% set effective = variant.promoPrice ?? variant.price %}
                                                            {% if effective is not null %}
                                                                {% set bundlePrices = bundlePrices|merge([effective]) %}
                                                            {% endif %}
                                                        {% endfor %}
                                                    {% else %}
                                                        {% set effective = item.component.promoPrice ?? item.component.price %}
                                                        {% if effective is not null %}
                                                            {% set bundlePrices = bundlePrices|merge([effective]) %}
                                                        {% endif %}
                                                    {% endif %}
                                                {% endif %}
                                            {% endfor %}
                                            {% if bundlePrices %}
                                                {% set sortedBundle = bundlePrices|sort %}
                                                {% set minBundle = sortedBundle|first %}
                                                {% set maxBundle = sortedBundle|last %}
                                                <div class="flex flex-col whitespace-nowrap">
                                                    <span class="font-semibold text-slate-900">{{ minBundle|number_format(2, ',', ' ') }} €</span>
                                                    <span class="text-xs text-slate-500">Prix min pack</span>
                                                    <span class="font-semibold text-slate-900 mt-2">{{ maxBundle|number_format(2, ',', ' ') }} €</span>
                                                    <span class="text-xs text-slate-500">Prix max pack</span>
                                                </div>
                                            {% else %}
                                                <span class="text-sm text-slate-500">—</span>
                                            {% endif %}
                                        {% else %}
                                            <div class="flex flex-col whitespace-nowrap">
                                                <span class="font-semibold text-slate-900">{{ product.price|number_format(2, ',', ' ') }} €</span>
                                                <span class="text-xs text-slate-500">Prix plein</span>
                                                <span class="text-sm text-blue-600">
                                                    {% if promoPrice %}
                                                        {{ promoPrice|number_format(2, ',', ' ') }} €
                                                    {% else %}
                                                        —
                                                    {% endif %}
                                                </span>
                                                <span class="text-xs text-slate-500">Promo</span>
                                            </div>
                                        {% endif %}
                                    </td>
                                    <td class="py-4 px-4 align-top" style="width:1%; white-space: nowrap;">
                                        {% if product.type == 'grouped' %}
                                            {% set groupedStocks = [] %}
                                            {% for item in product.bundleItems %}
                                                {% if item.component %}
                                                    {% set componentStock = 0 %}
                                                    {% if item.component.variants|length > 0 %}
                                                        {% for variant in item.component.variants %}
                                                            {% set componentStock = componentStock + (variant.stock ?? 0) %}
                                                        {% endfor %}
                                                    {% else %}
                                                        {% set componentStock = item.component.stock ?? 0 %}
                                                    {% endif %}
                                                    {% if componentStock > 0 %}
                                                        {% set groupedStocks = groupedStocks|merge([componentStock]) %}
                                                    {% endif %}
                                                {% endif %}
                                            {% endfor %}
                                            {% if groupedStocks %}
                                                {% set sortedStocks = groupedStocks|sort %}
                                                {% set minStock = sortedStocks|first %}
                                                <span class="inline-flex items-center rounded-full bg-green-50 px-3 py-1 text-xs font-semibold text-green-600">{{ minStock }} en stock</span>
                                            {% else %}
                                                <span class="inline-flex items-center rounded-full bg-red-50 px-3 py-1 text-xs font-semibold text-red-600">Rupture</span>
                                            {% endif %}
                                        {% elseif product.variants|length > 0 %}
                                            {% set totalStock = 0 %}
                                            {% for variant in product.variants %}
                                                {% set totalStock = totalStock + (variant.stock ?? 0) %}
                                            {% endfor %}
                                            {% if totalStock <= 0 %}
                                                <span class="inline-flex items-center rounded-full bg-red-50 px-3 py-1 text-xs font-semibold text-red-600">Rupture</span>
                                            {% elseif totalStock <= 10 %}
                                                <span class="inline-flex items-center rounded-full bg-amber-50 px-3 py-1 text-xs font-semibold text-amber-600">Faible ({{ totalStock }})</span>
                                            {% else %}
                                                <span class="inline-flex items-center rounded-full bg-green-50 px-3 py-1 text-xs font-semibold text-green-600">{{ totalStock }} en stock</span>
                                            {% endif %}
                                        {% else %}
                                            {% set totalStock = product.stock %}
                                            {% if totalStock <= 0 %}
                                                <span class="inline-flex items-center rounded-full bg-red-50 px-3 py-1 text-xs font-semibold text-red-600">Rupture</span>
                                            {% elseif totalStock <= 10 %}
                                                <span class="inline-flex items-center rounded-full bg-amber-50 px-3 py-1 text-xs font-semibold text-amber-600">Faible ({{ totalStock }})</span>
                                            {% else %}
                                                <span class="inline-flex items-center rounded-full bg-green-50 px-3 py-1 text-xs font-semibold text-green-600">{{ totalStock }} en stock</span>
                                            {% endif %}
                                        {% endif %}
                                    </td>
                                    <td class="py-4 px-4 align-top">
                                        {{ typeLabel }}
                                    </td>
                                    <td class="py-4 px-4 align-top text-sm text-slate-500">
                                        {{ product.updatedAt ? product.updatedAt|date('d/m/Y H:i') : '—' }}
                                    </td>
                                    <td class="py-4 px-4 align-top">
                                        <div class="flex items-center justify-end gap-2 text-slate-400">
                                            <a href="{{ path('app_vendor_product_edit', {id: product.id}) }}" class="hover:text-slate-900" title="Éditer">
                                                ✏️
                                            </a>
                                            <form method="post"
                                                  action="{{ path('app_vendor_product_duplicate', {id: product.id}) }}"
                                                  class="inline-flex"
                                                  onsubmit="return confirm('Dupliquer ce produit ?');">
                                                <input type="hidden" name="_token" value="{{ csrf_token('product_duplicate_' ~ product.id) }}">
                                                <button type="submit" class="hover:text-slate-900" title="Dupliquer">
                                                    📄
                                                </button>
                                            </form>
                                            <form method="post"
                                                  action="{{ path('app_vendor_product_toggle_publish', {id: product.id}) }}"
                                                  class="inline-flex">
                                                <input type="hidden" name="_token" value="{{ csrf_token('product_toggle_' ~ product.id) }}">
                                                <button type="submit"
                                                        class="hover:text-slate-900"
                                                        title="{{ product.isPublished ? 'Dépublier' : 'Publier' }}">
                                                    {{ product.isPublished ? '📥' : '📢' }}
                                                </button>
                                            </form>
                                            <form method="post"
                                                  action="{{ path('app_vendor_product_delete', {id: product.id}) }}"
                                                  class="inline-flex"
                                                  onsubmit="return confirm('Supprimer définitivement ce produit ?');">
                                                <input type="hidden" name="_token" value="{{ csrf_token('product_delete_' ~ product.id) }}">
                                                <button type="submit" class="hover:text-red-600" title="Supprimer">
                                                    🗑️
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
            {% if pagination.pages > 1 %}
                <div class="flex items-center justify-between border-t border-slate-100 pt-4 text-sm text-slate-600">
                    <p>Page {{ pagination.page }} / {{ pagination.pages }}</p>
                    <div class="flex gap-2">
                        {% set prev = pagination.page - 1 %}
                        {% set next = pagination.page + 1 %}
                        <a href="{{ path('app_vendor_products', app.request.query.all|merge({'page': 1})) }}" class="btn btn-outline btn-sm {{ pagination.page == 1 ? 'pointer-events-none opacity-50' : '' }}">Début</a>
                        <a href="{{ path('app_vendor_products', app.request.query.all|merge({'page': prev < 1 ? 1 : prev})) }}" class="btn btn-outline btn-sm {{ pagination.page == 1 ? 'pointer-events-none opacity-50' : '' }}">Préc.</a>
                        <a href="{{ path('app_vendor_products', app.request.query.all|merge({'page': next > pagination.pages ? pagination.pages : next})) }}" class="btn btn-outline btn-sm {{ pagination.page == pagination.pages ? 'pointer-events-none opacity-50' : '' }}">Suiv.</a>
                        <a href="{{ path('app_vendor_products', app.request.query.all|merge({'page': pagination.pages})) }}" class="btn btn-outline btn-sm {{ pagination.page == pagination.pages ? 'pointer-events-none opacity-50' : '' }}">Fin</a>
                    </div>
                </div>
            {% endif %}
        </section>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        function mesProduitsState(ids = []) {
            return {
                ids,
                selectedIds: [],
                toggleAll(event) {
                    this.selectedIds = event.target.checked ? [...this.ids] : [];
                },
                get allSelected() {
                    return this.selectedIds.length > 0 && this.selectedIds.length === this.ids.length;
                }
            };
        }
    </script>
{% endblock %}
