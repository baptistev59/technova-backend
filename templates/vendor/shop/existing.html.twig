{% extends 'vendor/layout.html.twig' %}

{% block title %}Tableau de bord vendeur — {{ shop.name }}{% endblock %}

{% block vendor_content %}
    {% set stats = stats ?? [
        { label: 'Commandes totales', value: 0, trend: 'Depuis l’ouverture', icon: '🧾' },
        { label: 'En attente', value: 0, trend: 'Statut pending', icon: '⏳' },
        { label: 'Payées / expédiées', value: 0, trend: 'Commandes validées', icon: '✅' },
        { label: 'Revenus cumulés', value: '0,00 €', trend: 'Cumul boutique', icon: '💶' }
    ] %}
    {% set orders_preview = orders_preview ?? [] %}
    {% set orders_metrics = orders_metrics ?? { revenue: 0, totalOrders: 0 } %}
    {% set status_badges = status_badges ?? {} %}
    {% set sales_trend = sales_trend ?? [] %}
    {% set revenue_trend = revenue_trend ?? [] %}
    {% if sales_trend is empty %}
        {% set sales_trend = [
            { label: 'J-6', value: 2 },
            { label: 'J-5', value: 1 },
            { label: 'J-4', value: 3 },
            { label: 'J-3', value: 2 },
            { label: 'J-2', value: 4 },
            { label: 'Hier', value: 1 },
            { label: 'Aujourd’hui', value: 3 },
        ] %}
    {% endif %}
    {% if revenue_trend is empty %}
        {% set revenue_trend = [
            { label: 'Jan', value: 950 },
            { label: 'Fév', value: 1200 },
            { label: 'Mar', value: 870 },
            { label: 'Avr', value: 1430 },
            { label: 'Mai', value: 1100 },
            { label: 'Juin', value: 1650 },
            { label: 'Juil', value: 980 },
            { label: 'Août', value: 1320 },
            { label: 'Sept', value: 1180 },
            { label: 'Oct', value: 1740 },
            { label: 'Nov', value: 1390 },
            { label: 'Déc', value: 2100 },
        ] %}
    {% endif %}
    <div>
        <p class="text-xs font-semibold tracking-[0.35em] text-slate-400 uppercase mb-2">Technova</p>
        <h1 class="text-3xl md:text-4xl font-semibold text-slate-900">Tableau de bord vendeur</h1>
        <p class="text-slate-500 mt-3">
            Suivi rapide de ta boutique <strong>{{ shop.name }}</strong>. Les sections se rempliront automatiquement dès que les modules commandes/produits seront finalisés.
        </p>
    </div>

    <div class="rounded-3xl border border-slate-100 bg-white p-6 shadow-sm">
        <div class="flex gap-4">
            {% if shop.logo %}
                <img src="{{ asset(shop.logo) }}" alt="{{ shop.name }}" class="w-16 h-16 rounded-full object-cover">
            {% else %}
                <span class="w-16 h-16 rounded-full bg-slate-100 flex items-center justify-center font-semibold text-slate-500">{{ shop.name|slice(0,2)|upper }}</span>
            {% endif %}
            <div class="flex-1 space-y-2">
                <div class="flex items-start justify-between gap-3">
                    <div>
                        <p class="font-semibold text-slate-900">{{ shop.name }}</p>
                        <p class="text-xs text-slate-500">Slug : {{ shop.slug }}</p>
                        <p class="text-xs text-slate-500">Email : {{ shop.contactEmail }}</p>
                    </div>
                    <a href="{{ path('app_vendor_shop_new', { edit: 1 }) }}" class="btn btn-outline btn-sm whitespace-nowrap">Modifier</a>
                </div>
                {% if shop.policies %}
                    <p class="text-xs text-slate-500 line-clamp-2">{{ shop.policies }}</p>
                {% endif %}
            </div>
        </div>
    </div>

    <div class="grid gap-6 sm:grid-cols-2 xl:grid-cols-4">
        {% for card in stats %}
            <article class="tn-product-card h-[240px] flex flex-col items-center justify-between text-center">
                <div class="text-3xl">{{ card.icon }}</div>
                <div class="w-full">
                    <p class="text-xs uppercase tracking-[0.2em] text-slate-400">{{ card.label }}</p>
                    <p class="text-3xl font-semibold text-slate-900 mt-3">{{ card.value }}</p>
                </div>
                <p class="text-xs font-medium text-blue-600">{{ card.trend }}</p>
            </article>
        {% endfor %}
    </div>

    <div class="rounded-3xl border border-slate-100 bg-white shadow-sm p-6 space-y-4">
        <div class="flex flex-col gap-2 md:flex-row md:items-center md:justify-between border-b border-slate-100 pb-4">
            <div>
                <h2 class="text-xl font-semibold text-slate-900">Commandes récentes</h2>
                <p class="text-sm text-slate-500">CA cumulé : {{ orders_metrics.revenue|default(0)|number_format(2, ',', ' ') }} €</p>
            </div>
            <a href="{{ path('app_vendor_orders') }}" class="btn btn-outline btn-sm">Voir toutes les commandes</a>
        </div>
        {% if orders_preview %}
            <div class="space-y-4">
                {% for entry in orders_preview %}
                    {% set order = entry.entity %}
                    {% set badge = status_badges[order.status] ?? { label: order.status, class: 'bg-slate-100 text-slate-600 border border-slate-200' } %}
                    <div class="rounded-2xl border border-slate-100 bg-slate-50/70 p-4 space-y-3">
                        <div class="flex flex-col gap-2 md:flex-row md:items-center md:justify-between">
                            <div>
                                <p class="text-sm font-semibold text-slate-900">{{ order.reference }}</p>
                                <p class="text-xs text-slate-500">Passée le {{ order.createdAt ? order.createdAt|date('d/m/Y H:i') : '—' }}</p>
                            </div>
                            <div class="flex items-center gap-3">
                                <span class="inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold {{ badge.class }}">{{ badge.label }}</span>
                                <p class="text-lg font-semibold text-slate-900">{{ entry.lineTotal|number_format(2, ',', ' ') }} €</p>
                            </div>
                        </div>
                        <div class="space-y-1 text-sm text-slate-600">
                            {% for line in entry.lines %}
                                <div class="flex items-center justify-between">
                                    <span>{{ line.name }} × {{ line.quantity }}</span>
                                    <span class="font-semibold text-slate-900">{{ line.lineTotal|number_format(2, ',', ' ') }} €</span>
                                </div>
                            {% endfor %}
                            {% if entry.moreLines > 0 %}
                                <p class="text-xs text-slate-500">… et {{ entry.moreLines }} autre{{ entry.moreLines > 1 ? 's' : '' }} article{{ entry.moreLines > 1 ? 's' : '' }}.</p>
                            {% endif %}
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <div class="text-center text-slate-500 py-8 border border-dashed border-slate-200 rounded-2xl">
                Aucune commande pour le moment. Elles apparaîtront ici dès qu’un client aura validé un panier.
            </div>
        {% endif %}
    </div>

    <div class="rounded-3xl border border-blue-100 bg-white shadow-sm p-6 space-y-4">
        <div class="flex items-center justify-between border-b border-slate-100 pb-4">
            <div>
                <h2 class="text-xl font-semibold text-slate-900">Bibliothèque d’attributs</h2>
                <p class="text-sm text-slate-500">Mutualise tes attributs (taille, couleur, édition…) pour tous tes produits.</p>
            </div>
            <a href="{{ path('app_vendor_attributes') }}" class="btn btn-primary btn-sm whitespace-nowrap">Gérer</a>
        </div>
        <div class="grid gap-4 md:grid-cols-3">
            <div class="rounded-2xl border border-slate-100 bg-slate-50/50 p-4">
                <p class="text-xs uppercase tracking-[0.2em] text-slate-400">Attributs globaux</p>
                <p class="text-2xl font-semibold text-slate-900 mt-2">{{ attributeStats.attributes ?? 0 }}</p>
                <p class="text-xs text-slate-500 mt-1">Définis une fois, réutilisés partout.</p>
            </div>
            <div class="rounded-2xl border border-slate-100 bg-slate-50/50 p-4">
                <p class="text-xs uppercase tracking-[0.2em] text-slate-400">Valeurs disponibles</p>
                <p class="text-2xl font-semibold text-slate-900 mt-2">{{ attributeStats.values ?? 0 }}</p>
                <p class="text-xs text-slate-500 mt-1">Couleurs, tailles, capacités…</p>
            </div>
            <div class="rounded-2xl border border-slate-100 bg-slate-50/50 p-4">
                <p class="text-xs uppercase tracking-[0.2em] text-slate-400">Variantes générées</p>
                <p class="text-2xl font-semibold text-slate-900 mt-2">{{ attributeStats.variants ?? 0 }}</p>
                <p class="text-xs text-slate-500 mt-1">Chaque combinaison crée une fiche variante.</p>
            </div>
        </div>
        <p class="text-xs text-slate-500">
            Ajoute d’abord tes attributs globaux, rattache-les aux produits puis laisse la génération automatique créer les variantes.
        </p>
    </div>

    <div class="rounded-3xl border border-slate-100 bg-white shadow-sm p-6 space-y-4">
        <div class="border-b border-slate-100 pb-4">
            <h2 class="text-xl font-semibold text-slate-900">Statistiques</h2>
            <p class="text-sm text-slate-500">Tendances basées sur tes commandes réelles.</p>
        </div>
        <div class="grid md:grid-cols-2 gap-6">
            <div class="bg-slate-50 rounded-xl px-4 py-6 space-y-4">
                <p class="text-sm font-medium text-slate-500">Ventes — 30 derniers jours</p>
                <div class="relative h-24">
                    <canvas id="salesChart" class="w-full h-full"></canvas>
                </div>
            </div>
            <div class="bg-slate-50 rounded-xl px-4 py-6 space-y-4">
                <p class="text-sm font-medium text-slate-500">Revenus — 12 derniers mois</p>
                <div class="relative h-24">
                    <canvas id="revenueChart" class="w-full h-full"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="rounded-3xl border border-slate-100 bg-white shadow-sm p-6 space-y-4">
        <div class="border-b border-slate-100 pb-4">
            <h2 class="text-xl font-semibold text-slate-900">Mes derniers produits</h2>
            <p class="text-sm text-slate-500">Retrouve les fiches créées récemment et continue de les enrichir.</p>
        </div>
        {% if latest_products is empty %}
            <div class="text-center space-y-3 py-8 text-slate-500">
                <p>Ajoute un produit pour qu’il apparaisse ici dans ton espace vendeur.</p>
                <div class="flex justify-center">
                    <a href="{{ path('app_vendor_product_new') }}" class="btn btn-primary btn-sm">Ajouter un produit</a>
                </div>
            </div>
        {% else %}
            <div class="swiper tn-carousel" data-swiper-init data-swiper-visible="3">
                <div class="swiper-wrapper">
                    {% for product in latest_products|slice(0, 10) %}
                        {% set mainImage = product.primaryImage %}
                        <div class="swiper-slide p-3 h-auto">
                            <article class="tn-product-card tn-product-card--carousel h-full flex flex-col">
                                <div class="tn-product-card__media">
                                    <img
                                        src="{{ mainImage ? asset(mainImage.url) : asset('assets/images/product-placeholder.svg') }}"
                                        alt="{{ mainImage ? mainImage.alt : product.name }}"
                                    >
                                </div>
                                <div class="mt-4">
                                    <h3 class="tn-product-card__title" title="{{ product.name }}">{{ product.name }}</h3>
                                    {% if product.shortDescription %}
                                        <p class="text-sm text-slate-500 mt-2 line-clamp-3">{{ product.shortDescription }}</p>
                                    {% endif %}
                                    <div class="tn-product-card__meta mt-3">
                                        <span>{{ product.brand ? product.brand.name : shop.name }}</span>
                                        <strong>{{ product.price|number_format(2, ',', ' ') }} €</strong>
                                    </div>
                                </div>
                                <div class="tn-product-card__cta mt-auto">
                                    <a class="btn btn-primary w-full" href="{{ path('product_show', { slug: product.slug }) }}">Découvrir</a>
                                </div>
                            </article>
                        </div>
                    {% endfor %}
                </div>
                <div class="swiper-pagination"></div>
                <div class="swiper-button-prev"></div>
                <div class="swiper-button-next"></div>
            </div>
        {% endif %}
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const salesData = {{ sales_trend|json_encode|raw }};
            const revenueData = {{ revenue_trend|json_encode|raw }};

            const salesCtx = document.getElementById('salesChart');
            if (salesCtx && salesData.length) {

                new Chart(salesCtx, {
                    type: 'line',
                    data: {
                        labels: salesData.map(point => point.label),
                        datasets: [{
                            data: salesData.map(point => point.value),
                            cubicInterpolationMode: 'monotone',
                            tension: 0.4,
                            borderColor: '#2563eb',
                            backgroundColor: 'rgba(37,99,235,0.12)',
                            fill: true,
                            borderWidth: 1.5,
                            pointRadius: 2.5,
                            pointBackgroundColor: '#2563eb',
                        }]
                    },
                    options: {
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false },
                            tooltip: { enabled: true, callbacks: { label: ctx => ctx.parsed.y + ' commandes' } }
                        },
                        scales: {
                            x: { display: false },
                            y: { display: false, beginAtZero: true, grace: '10%' }
                        }
                    }
                });
                
            }

            const revenueCtx = document.getElementById('revenueChart');
            if (revenueCtx && revenueData.length) {

                new Chart(revenueCtx, {
                    type: 'bar',
                    data: {
                        labels: revenueData.map(point => point.label),
                        datasets: [{
                            data: revenueData.map(point => point.value),
                            backgroundColor: 'rgba(16,185,129,0.65)',
                            borderRadius: 4,
                            borderSkipped: false,
                        }]
                    },
                    options: {
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                enabled: true,
                                callbacks: { label: ctx => new Intl.NumberFormat('fr-FR', { style: 'currency', currency: 'EUR' }).format(ctx.parsed.y) }
                            }
                        },
                        scales: {
                            x: { display: false },
                            y: { display: false, beginAtZero: true, grace: '10%' },
                        }
                    }
                });
                
            }
        });
    </script>
{% endblock %}
