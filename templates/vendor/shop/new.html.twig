{% extends 'base.html.twig' %}

{% set is_edit = is_edit ?? false %}
{% set shop = shop ?? null %}
{% set page_title = is_edit ? 'Modifier ma boutique' : 'Créer ma boutique' %}
{% block title %}{{ page_title }} — TechNova{% endblock %}

{% block body %}
    {% set existingLogo = shop and shop.logo ? asset(shop.logo) : null %}
    {% set existingBanner = shop and shop.banner ? asset(shop.banner) : null %}
    <section class="bg-slate-50 py-10" x-data="{ steps: 3 }">
        <div class="max-w-7xl mx-auto px-4">
            <div class="grid gap-10 lg:grid-cols-[minmax(0,1.7fr)_0.6fr] rounded-[32px] border border-slate-200 bg-white p-8 shadow-[0_35px_80px_rgba(15,25,36,0.08)]">
                <div class=" space-y-10">
                    <header class="space-y-4 text-center">
                        <div>
                            <p class="text-xs font-semibold tracking-[0.35em] text-slate-400 uppercase">Technova</p>
                            <h1 class="text-3xl md:text-4xl font-semibold text-slate-900">{{ page_title }}</h1>
                        </div>
                        <p class="text-slate-500">
                            Renseigne les informations principales de ta boutique afin de débloquer l’accès complet à l’espace vendeur.
                            Tu pourras ensuite publier tes produits et suivre tes commandes depuis le tableau de bord.
                        </p>
                    </header>

                    {% set form_action = is_edit ? path('app_vendor_shop_new', { edit: 1 }) : path('app_vendor_shop_new') %}
                    {{ form_start(form, {attr: {class: 'space-y-10'}, action: form_action}) }}
                        <section class="space-y-6 rounded-3xl border border-slate-100 bg-white shadow-sm p-6">
                            <div>
                                <div class="flex items-center justify-between mb-3">
                                    <h2 class="text-lg font-semibold text-slate-900">Identité de la boutique</h2>
                                    <span class="text-xs uppercase tracking-[0.3em] text-slate-400 hidden md:inline">Étape 1 / 3</span>
                                </div>
                                <div class="space-y-6">
                                    <div>
                                        <label class="block text-sm font-medium text-slate-600 mb-2">Nom de la boutique</label>
                                        {{ form_widget(form.name, {attr: {class: 'tn-input rounded-2xl border border-slate-200 bg-slate-50 p-4'}}) }}
                                        {{ form_errors(form.name) }}
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-slate-600 mb-2">Description</label>
                                        {{ form_widget(form.description, {attr: {class: 'tn-textarea min-h-[300px] min-w-[100%] rounded-2xl border border-slate-200 bg-slate-50 p-4'}}) }}
                                        <p class="tn-help">Partage ton histoire, ton positionnement ou les marques que tu représentes.</p>
                                        {{ form_errors(form.description) }}
                                    </div>
                                </div>
                            </div>
                        </section>

                        <section class="space-y-6 rounded-3xl border border-slate-100 bg-white shadow-sm p-6">
                            <div>
                                <div class="flex items-center justify-between mb-3">
                                    <h2 class="text-lg font-semibold text-slate-900">Informations légales</h2>
                                    <span class="text-xs uppercase tracking-[0.3em] text-slate-400 hidden md:inline">Étape 2 / 4</span>
                                </div>
                                <div class="space-y-6">
                                    <div>
                                        <label class="block text-sm font-medium text-slate-600 mb-2">Raison sociale</label>
                                        {{ form_widget(form.owner.companyName, {attr: {class: 'tn-input rounded-2xl border border-slate-200 bg-slate-50 p-4'}}) }}
                                        {{ form_errors(form.owner.companyName) }}
                                    </div>
                                    <div class="grid md:grid-cols-2 gap-6">
                                        <div>
                                            <label class="block text-sm font-medium text-slate-600 mb-2">Type d’identifiant</label>
                                            {{ form_widget(form.owner.businessIdType, {attr: {class: 'tn-input rounded-2xl border border-slate-200 bg-slate-50 p-4'}}) }}
                                            {{ form_errors(form.owner.businessIdType) }}
                                        </div>
                                        <div>
                                            <label class="block text-sm font-medium text-slate-600 mb-2">Identifiant</label>
                                            {{ form_widget(form.owner.businessId, {attr: {class: 'tn-input rounded-2xl border border-slate-200 bg-slate-50 p-4'}}) }}
                                            {{ form_errors(form.owner.businessId) }}
                                        </div>
                                    </div>
                                    <div class="grid md:grid-cols-2 gap-6">
                                        <div>
                                            <label class="block text-sm font-medium text-slate-600 mb-2">Téléphone professionnel</label>
                                            {{ form_widget(form.owner.phone, {attr: {class: 'tn-input rounded-2xl border border-slate-200 bg-slate-50 p-4'}}) }}
                                            {{ form_errors(form.owner.phone) }}
                                        </div>
                                        <div>
                                            <label class="block text-sm font-medium text-slate-600 mb-2">Site web</label>
                                            {{ form_widget(form.owner.website, {attr: {class: 'tn-input rounded-2xl border border-slate-200 bg-slate-50 p-4'}}) }}
                                            {{ form_errors(form.owner.website) }}
                                        </div>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-slate-600 mb-2">Email légal</label>
                                        {{ form_widget(form.owner.email, {attr: {class: 'tn-input rounded-2xl border border-slate-200 bg-slate-50 p-4'}}) }}
                                        {{ form_errors(form.owner.email) }}
                                    </div>
                                    <div class="pt-2">
                                        <p class="text-sm font-semibold text-slate-700 mb-1">Adresse professionnelle</p>
                                        <p class="text-xs text-red-600 mb-3">Ces champs doivent être complétés pour valider ta boutique.</p>
                                        <div class="grid md:grid-cols-2 gap-6">
                                            <div class="space-y-4">
                                                <div>
                                                    {{ form_label(form.owner.address.addressLine1, null, {label_attr: {class: 'block text-xs font-semibold text-slate-500 mb-2'}}) }}
                                                    {{ form_widget(form.owner.address.addressLine1, {attr: {class: 'tn-input rounded-2xl border border-slate-200 bg-slate-50 p-4', placeholder: 'Numéro et rue'}}) }}
                                                    {{ form_errors(form.owner.address.addressLine1) }}
                                                </div>
                                                <div>
                                                    <label class="block text-xs font-semibold text-slate-500 mb-2">Complément</label>
                                                    {{ form_widget(form.owner.address.addressLine2, {attr: {class: 'tn-input rounded-2xl border border-slate-200 bg-slate-50 p-4', placeholder: 'Bâtiment, étage…'}}) }}
                                                    {{ form_errors(form.owner.address.addressLine2) }}
                                                </div>
                                                <div>
                                                    {{ form_label(form.owner.address.postalCode, null, {label_attr: {class: 'block text-xs font-semibold text-slate-500 mb-2'}}) }}
                                                    {{ form_widget(form.owner.address.postalCode, {attr: {class: 'tn-input rounded-2xl border border-slate-200 bg-slate-50 p-4', placeholder: '75001'}}) }}
                                                    {{ form_errors(form.owner.address.postalCode) }}
                                                </div>
                                            </div>
                                            <div class="space-y-4">
                                                    <div>
                                                        {{ form_label(form.owner.address.city, null, {label_attr: {class: 'block text-xs font-semibold text-slate-500 mb-2'}}) }}
                                                        {{ form_widget(form.owner.address.city, {attr: {class: 'tn-input rounded-2xl border border-slate-200 bg-slate-50 p-4', placeholder: 'Paris'}}) }}
                                                        {{ form_errors(form.owner.address.city) }}
                                                    </div>
                                                    <div>
                                                        <label class="block text-xs font-semibold text-slate-500 mb-2">Région / Département</label>
                                                        {{ form_widget(form.owner.address.state, {attr: {class: 'tn-input rounded-2xl border border-slate-200 bg-slate-50 p-4', placeholder: 'Île-de-France'}}) }}
                                                        {{ form_errors(form.owner.address.state) }}
                                                    </div>
                                                    <div>
                                                        {{ form_label(form.owner.address.country, null, {label_attr: {class: 'block text-xs font-semibold text-slate-500 mb-2'}}) }}
                                                        {{ form_widget(form.owner.address.country, {attr: {class: 'tn-select rounded-2xl border border-slate-200 bg-slate-50 p-4'}}) }}
                                                        {{ form_errors(form.owner.address.country) }}
                                                    </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>

                        <section class="space-y-6 rounded-3xl border border-slate-100 bg-white shadow-sm p-6">
                            <div>
                                <div class="flex items-center justify-between mb-3">
                                    <h2 class="text-lg font-semibold text-slate-900">Contact & Service client</h2>
                                    <span class="text-xs uppercase tracking-[0.3em] text-slate-400 hidden md:inline">Étape 3 / 4</span>
                                </div>
                                <div class="space-y-6">
                                    <div>
                                        <label class="block text-sm font-medium text-slate-600 mb-2">Email de contact</label>
                                        {{ form_widget(form.contactEmail, {attr: {class: 'tn-input rounded-2xl border border-slate-200 bg-slate-50 px-4 py-2'}}) }}
                                        {{ form_errors(form.contactEmail) }}
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-slate-600 mb-2">Politique SAV / livraison</label>
                                        {{ form_widget(form.policies, {attr: {class: 'tn-textarea min-h-[300px] min-w-[100%] rounded-2xl border border-slate-200 bg-slate-50 p-4'}}) }}
                                        <p class="tn-help">Délais de livraison, retours, garanties…</p>
                                        {{ form_errors(form.policies) }}
                                    </div>
                                </div>
                            </div>
                        </section>

                        <section class="space-y-6 rounded-3xl border border-slate-100 bg-white shadow-sm p-6">
                            <div>
                                <div class="flex items-center justify-between mb-3">
                                    <h2 class="text-lg font-semibold text-slate-900">Visuels</h2>
                                    <span class="text-xs uppercase tracking-[0.3em] text-slate-400 hidden md:inline">Étape 4 / 4</span>
                                </div>
                                <div class="grid md:grid-cols-2 gap-6">
                                    <div class="tn-upload" x-data="{ preview: {{ existingLogo ? '\'' ~ existingLogo|e('js') ~ '\'' : 'null' }} }">
                                        <label class="block text-sm font-medium text-slate-600 mb-2">Logo (PNG/JPG)</label>
                                        {{ form_widget(form.logoFile, {
                                            attr: {
                                                class: 'sr-only',
                                                'x-ref': 'logoInput',
                                                '@change': 'const [file] = $event.target.files; preview = file ? URL.createObjectURL(file) : null'
                                            }
                                        }) }}
                                        <p class="tn-help">Format carré recommandé, 500 Ko max.</p>
                                        {{ form_errors(form.logoFile) }}
                                        <div class="mt-3">
                                            <button type="button"
                                                    class="h-28 w-28 rounded-2xl border border-slate-200 bg-slate-50 flex items-center justify-center overflow-hidden relative focus:outline-none focus:ring-2 focus:ring-blue-200"
                                                    @click="$refs.logoInput.click()">
                                                <template x-if="preview">
                                                    <img :src="preview" alt="Prévisualisation logo" class="object-cover h-full w-full">
                                                </template>
                                                <template x-if="!preview">
                                                    <span class="text-xs text-slate-400 text-center px-2">Prévisualisation du logo</span>
                                                </template>
                                                <span class="absolute inset-0 bg-slate-900/40 text-white text-[10px] uppercase tracking-[0.3em] flex items-center justify-center opacity-0 transition group-hover:opacity-100">Changer</span>
                                            </button>
                                        </div>
                                    </div>
                                    <div class="tn-upload" x-data="{ preview: {{ existingBanner ? '\'' ~ existingBanner|e('js') ~ '\'' : 'null' }} }">
                                        <label class="block text-sm font-medium text-slate-600 mb-2">Bannière</label>
                                        {{ form_widget(form.bannerFile, {
                                            attr: {
                                                class: 'sr-only',
                                                'x-ref': 'bannerInput',
                                                '@change': 'const [file] = $event.target.files; preview = file ? URL.createObjectURL(file) : null'
                                            }
                                        }) }}
                                        <p class="tn-help">Image horizontale pour l’en-tête de la boutique.</p>
                                        {{ form_errors(form.bannerFile) }}
                                        <div class="mt-3">
                                            <button type="button"
                                                    class="h-32 rounded-2xl border border-slate-200 bg-slate-50 flex items-center justify-center overflow-hidden relative w-full focus:outline-none focus:ring-2 focus:ring-blue-200"
                                                    @click="$refs.bannerInput.click()">
                                                <template x-if="preview">
                                                    <img :src="preview" alt="Prévisualisation bannière" class="object-cover h-full w-full">
                                                </template>
                                                <template x-if="!preview">
                                                    <span class="text-xs text-slate-400 text-center px-2">Prévisualisation de la bannière</span>
                                                </template>
                                                <span class="absolute inset-0 bg-slate-900/40 text-white text-[10px] uppercase tracking-[0.3em] flex items-center justify-center opacity-0 transition group-hover:opacity-100">Changer</span>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>

                        <div class="flex items-center justify-end gap-4 pt-4">
                            <a href="{{ path('app_vendor_shop_new') }}" class="btn btn-outline">Retour</a>
                            <button type="submit" class="btn btn-primary">
                                {{ is_edit ? 'Enregistrer les modifications' : 'Publier ma boutique' }}
                            </button>
                        </div>
                    {{ form_end(form) }}
                </div>

                    <aside class="space-y-6">
                        <div class="rounded-3xl border border-blue-100 bg-blue-50/80 p-6 shadow-sm space-y-4">
                            <p class="text-xs uppercase tracking-[0.3em] text-blue-500">Checklist</p>
                            <ul class="space-y-3 text-sm text-slate-600">
                                <li>• Renseigner un email de contact valide.</li>
                                <li>• Décrire ta politique SAV / livraison.</li>
                                <li>• Fournir un logo et une bannière.</li>
                                <li>• Vérifier l’orthographe avant publication.</li>
                            </ul>
                        </div>
                        <div class="rounded-3xl border border-slate-100 bg-white p-6 shadow-sm space-y-4">
                            <p class="text-xs uppercase tracking-[0.3em] text-slate-400">Astuce</p>
                            <p class="text-sm text-slate-600">Tu peux revenir modifier ces informations à tout moment depuis ton tableau de bord vendeur.</p>
                            <p class="text-sm text-slate-500">Besoin d’aide ? <a href="mailto:support@technova.test" class="text-blue-600">support@technova.test</a></p>
                        </div>
                    </aside>
            </div>
        </div>
    </section>
{% endblock %}
