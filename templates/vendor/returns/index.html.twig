{% extends 'vendor/layout.html.twig' %}

{% block title %}Retours — {{ shop.name }}{% endblock %}

{% block vendor_content %}
    <div class="space-y-6">
        <div>
            <p class="text-xs uppercase tracking-[0.35em] text-slate-400">Retours</p>
            <h1 class="text-3xl font-semibold text-slate-900">Demandes de retour</h1>
        </div>

        <div class="rounded-3xl border border-slate-100 bg-white p-6 shadow-sm">
            {% if returns is empty %}
                <p class="text-sm text-slate-500">Aucune demande pour le moment.</p>
            {% else %}
                <div class="space-y-4">
                    {% for request in returns %}
                        <div class="rounded-2xl border border-slate-100 p-4">
                            <div class="flex flex-wrap items-start justify-between gap-4">
                                <div>
                                    <p class="text-xs uppercase tracking-[0.3em] text-slate-400">Commande</p>
                                    <p class="text-lg font-semibold text-slate-900">{{ request.order.reference }}</p>
                                    <p class="text-sm text-slate-500 mt-1">
                                        Client: {{ request.requester.email ?? 'inconnu' }}
                                    </p>
                                </div>
                                <div class="text-right">
                                    {% set statusLabel = {
                                        'pending': 'En attente',
                                        'approved': 'Validée',
                                        'rejected': 'Refusée'
                                    } %}
                                    <span class="inline-flex items-center rounded-full border border-slate-200 px-3 py-1 text-xs font-semibold text-slate-600">
                                        {{ statusLabel[request.status.value] ?? request.status.value }}
                                    </span>
                                    <p class="text-xs text-slate-400 mt-2">Créée le {{ request.createdAt|date('d/m/Y') }}</p>
                                </div>
                            </div>
                            <div class="mt-3 text-sm text-slate-600">
                                <p><span class="font-semibold">Motif:</span> {{ request.reason }}</p>
                                {% if request.details %}
                                    <p class="mt-1 text-slate-500">{{ request.details }}</p>
                                {% endif %}
                            </div>
                            {% if request.status.value == 'pending' %}
                                <div class="mt-4 flex flex-wrap gap-2">
                                    <form method="post" action="{{ path('app_vendor_returns_approve', { id: request.id }) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('approve_return_' ~ request.id) }}">
                                        <button class="btn btn-primary btn-sm" type="submit">Valider</button>
                                    </form>
                                    <form method="post" action="{{ path('app_vendor_returns_reject', { id: request.id }) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('reject_return_' ~ request.id) }}">
                                        <button class="btn btn-outline btn-sm" type="submit">Refuser</button>
                                    </form>
                                </div>
                            {% elseif request.status.value == 'approved' %}
                                <div class="mt-4 flex flex-wrap gap-2 items-center">
                                    {% if request.order.refundedAt %}
                                        <span class="inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold bg-slate-100 text-slate-600 border border-slate-200">
                                            Remboursée
                                        </span>
                                    {% else %}
                                        <form method="post" action="{{ path('app_vendor_returns_refund', { id: request.id }) }}" class="flex flex-wrap items-center gap-2" onsubmit="return confirm('Rembourser cette commande ?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('refund_return_' ~ request.id) }}">
                                            <input
                                                type="text"
                                                name="refund_amount"
                                                placeholder="Montant € (optionnel)"
                                                class="border border-slate-200 rounded-full px-3 py-1 text-xs w-36"
                                            >
                                            <button class="btn btn-outline btn-sm" type="submit">Rembourser</button>
                                        </form>
                                    {% endif %}
                                </div>
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
