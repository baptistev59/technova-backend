{% extends 'vendor/layout.html.twig' %}

{% block title %}
    {{ rate and rate.id ? 'Modifier le taux' : 'Créer un taux' }} — TechNova
{% endblock %}

{% block body %}
    {% set is_edit = rate and rate.id %}

    <section class="bg-slate-50 py-10">
        <div class="max-w-5xl mx-auto px-4">
            <div class="flex items-center justify-between mb-6">
                <div>
                    <p class="text-xs uppercase tracking-[0.3em] text-blue-400">TechNova</p>
                    <h1 class="text-3xl font-semibold text-slate-900">{{ is_edit ? 'Modifier le taux' : 'Créer un taux' }}</h1>
                    <p class="text-slate-500 mt-2">Gère le taux de TVA applicable pour un pays et une classe.</p>
                </div>
                <a href="{{ path('app_vendor_vatrates') }}" class="btn btn-outline">← Retour aux taux</a>
            </div>

            <div class="bg-white rounded-[32px] border border-slate-100 shadow-[0_30px_90px_rgba(15,25,36,0.08)] p-8 space-y-6">
                {{ form_start(form, {attr: {class: 'space-y-8'}}) }}

                <div class="grid gap-6 md:grid-cols-2">
                    <div>
                        {{ form_label(form.countryCode, null, {label_attr: {class: 'tn-label'}}) }}
                        {{ form_widget(form.countryCode, {attr: {class: 'tn-input'}}) }}
                        {{ form_errors(form.countryCode) }}
                    </div>
                    <div>
                        {{ form_label(form.code, null, {label_attr: {class: 'tn-label'}}) }}
                        {{ form_widget(form.code, {attr: {class: 'tn-input-select'}}) }}
                        {{ form_errors(form.code) }}
                    </div>
                    <div>
                        {{ form_label(form.label, null, {label_attr: {class: 'tn-label'}}) }}
                        {{ form_widget(form.label, {attr: {class: 'tn-input'}}) }}
                        {{ form_errors(form.label) }}
                    </div>
                    <div>
                        {{ form_label(form.rate, null, {label_attr: {class: 'tn-label'}}) }}
                        {{ form_widget(form.rate, {attr: {class: 'tn-input'}}) }}
                        {{ form_errors(form.rate) }}
                    </div>
                </div>

                <div class="flex items-center gap-6">
                    <div>
                        {{ form_widget(form.isDefault) }} {{ form_label(form.isDefault) }}
                        {{ form_errors(form.isDefault) }}
                    </div>
                    <div>
                        {{ form_widget(form.active) }} {{ form_label(form.active) }}
                        {{ form_errors(form.active) }}
                    </div>
                </div>

                <div class="flex items-center justify-between pt-4 border-t border-slate-100">
                    {{ form_rest(form) }}
                    <button type="submit" class="btn btn-primary px-8">{{ is_edit ? 'Mettre à jour' : 'Publier le taux' }}</button>
                </div>

                {{ form_end(form, {render_rest: false}) }}
            </div>
        </div>
    </section>
{% endblock %}
