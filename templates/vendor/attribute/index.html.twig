{% extends 'vendor/layout.html.twig' %}

{% block vendor_content %}
    <div class="space-y-6">
        <div class="flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
            <div>
                <p class="text-xs font-semibold uppercase tracking-[0.35em] text-slate-400">Catalogue — Attributs</p>
                <h1 class="text-3xl font-semibold text-slate-900">Bibliothèque d’attributs</h1>
                <p class="text-slate-500 mt-2">
                    Crée des attributs globaux (couleur, capacité, édition…) pour les réutiliser dans tous tes produits variables.
                </p>
            </div>
            <div class="flex gap-3">
                <a href="{{ path('app_vendor_attributes_new') }}" class="btn btn-primary whitespace-nowrap">Créer un attribut</a>
            </div>
        </div>

        {% if attributes is empty %}
            <div class="rounded-3xl border border-dashed border-slate-200 bg-slate-50 p-10 text-center space-y-3">
                <p class="text-lg font-semibold text-slate-900">Aucun attribut enregistré</p>
                <p class="text-slate-500">Ajoute ton premier attribut pour proposer des variantes (couleur, taille, édition…).</p>
                <a href="{{ path('app_vendor_attributes_new') }}" class="btn btn-outline">Créer mon premier attribut</a>
            </div>
        {% else %}
            <div class="space-y-4">
                {% for attribute in attributes %}
                    <article class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
                        <div class="flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
                            <div class="space-y-1">
                                <p class="text-xs uppercase tracking-[0.3em] text-slate-400">Attribut</p>
                                <h2 class="text-2xl font-semibold text-slate-900">{{ attribute.name }}</h2>
                                <p class="text-sm text-slate-500">Slug : <code class="text-xs">{{ attribute.slug ?: '—' }}</code></p>
                                <p class="text-sm text-slate-500">
                                    Type d’entrée : 
                                    {% if attribute.inputType == 'chip' %}
                                        Boutons
                                    {% elseif attribute.inputType == 'radio' %}
                                        Boutons radio
                                    {% else %}
                                        Menu déroulant
                                    {% endif %}
                                    • {{ attribute.values|length }} valeur{{ attribute.values|length > 1 ? 's' : '' }}
                                </p>
                            </div>
                            <div class="flex flex-wrap gap-3">
                                <a href="{{ path('app_vendor_attributes_edit', {id: attribute.id}) }}" class="btn btn-outline">Modifier</a>
                                <form method="post" action="{{ path('app_vendor_attributes_delete', {id: attribute.id}) }}" onsubmit="return confirm('Supprimer cet attribut ?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('attribute_delete_' ~ attribute.id) }}">
                                    <button type="submit" class="btn btn-outline text-red-600 border-red-200 hover:bg-red-50">Supprimer</button>
                                </form>
                            </div>
                        </div>

                        {% if attribute.values|length %}
                            <div class="mt-4 border-t border-slate-100 pt-4">
                                <p class="text-xs font-semibold uppercase tracking-[0.25em] text-slate-400 mb-2">Valeurs disponibles</p>
                                <div class="flex flex-wrap gap-2">
                                    {% for value in attribute.values %}
                                        <span class="rounded-full border border-slate-200 bg-slate-50 px-3 py-1 text-xs font-medium text-slate-700">
                                            {{ value.label }}
                                            <span class="text-slate-400">({{ value.value }})</span>
                                        </span>
                                    {% endfor %}
                                </div>
                            </div>
                        {% endif %}
                    </article>
                {% endfor %}
            </div>
        {% endif %}
    </div>
{% endblock %}
