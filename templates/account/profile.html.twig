{% extends 'base.html.twig' %}
{% form_theme profileForm 'form/tailwind_form_theme.html.twig' %}

{% block title %}Mon profil{% endblock %}

{% block body %}
<section class="tn-main max-w-5xl mx-auto">
    <div class="rounded-[38px] bg-white p-10 shadow-[0_40px_90px_rgba(15,25,36,0.08)]">
        <div class="grid gap-10 lg:grid-cols-[minmax(0,1.7fr)_1fr]">
            <div>
                <p class="text-xs font-semibold tracking-[0.35em] text-slate-400 uppercase mb-2">Technova</p>
                <h1 class="text-3xl font-bold mb-2">Compléter mon profil</h1>
                <p class="text-slate-500 mb-6">
                    Nous utilisons ces informations pour préparer tes commandes et sécuriser ton espace.
                </p>

                {% for message in app.flashes('success') %}
                    <div class="mb-5 rounded-2xl border border-green-200 bg-green-50 px-4 py-3 text-green-800">
                        {{ message }}
                    </div>
                {% endfor %}

                {{ form_start(profileForm, {
                    attr: {
                        class: 'space-y-8',
                        enctype: 'multipart/form-data'
                    }
                }) }}

                <div class="rounded-3xl border border-slate-100 bg-slate-50/80 p-6 space-y-4">
                    <div class="flex items-center justify-between mb-4">
                        <h2 class="text-lg font-semibold text-slate-800">Informations personnelles</h2>
                        <span class="text-xs text-slate-400">Obligatoires pour la livraison sécurisée</span>
                    </div>
                    <div class="grid gap-4 md:grid-cols-2">
                        {{ form_row(profileForm.firstname) }}
                        {{ form_row(profileForm.lastname) }}
                    </div>
                    <div class="grid gap-6 md:grid-cols-[auto,1fr] items-center">
                        {% set avatarInputId = profileForm.avatarFile.vars.id %}
                        <label for="{{ avatarInputId }}" class="group flex items-center justify-center cursor-pointer focus:outline-none" data-avatar-trigger aria-label="Choisir un nouvel avatar" role="button" tabindex="0">
                            {% set avatarUrl = null %}
                            {% if viewer is defined and viewer and viewer.avatarPath %}
                                {% set avatarUrl = viewer.avatarPath starts with 'http' ? viewer.avatarPath : asset(viewer.avatarPath) %}
                            {% endif %}
                            <div class="relative h-20 w-20 rounded-full bg-white border border-slate-200 shadow-inner overflow-hidden transition hover:shadow-md" data-avatar-preview>
                                {% if avatarUrl %}
                                    <img src="{{ avatarUrl }}" alt="Avatar actuel" class="absolute inset-0 h-full w-full object-cover object-center">
                                {% else %}
                                    <span class="text-slate-400 text-lg font-semibold">Avatar</span>
                                {% endif %}
                                <div class="pointer-events-none absolute inset-0 bg-slate-900/40 text-white text-xs font-semibold uppercase tracking-wide flex items-center justify-center opacity-0 transition group-hover:opacity-100">Changer</div>
                            </div>
                        </label>
                        <div>
                            {{ form_widget(profileForm.avatarFile, {'attr': {'class': 'sr-only', 'data-avatar-input': 'true'}}) }}
                            <p class="text-xs text-slate-500 mt-1">Clique sur l’avatar pour choisir un nouveau fichier (PNG/JPG/AVIF, 2 Mo max).</p>
                            <p class="mt-2 text-sm font-semibold text-red-600" data-avatar-inline-error aria-live="polite"></p>
                            {{ form_errors(profileForm.avatarFile) }}
                        </div>
                    </div>
                    <div class="grid gap-4 md:grid-cols-2">
                        {{ form_row(profileForm.phone) }}
                        <div class="rounded-2xl border border-slate-200 bg-white p-4">
                            <label class="flex items-center gap-3 text-sm text-slate-700">
                                {{ form_widget(profileForm.newsletterOptIn) }}
                                <span>Recevoir les nouveautés TechNova</span>
                            </label>
                            {{ form_errors(profileForm.newsletterOptIn) }}
                        </div>
                    </div>
                </div>

                <div class="rounded-3xl border border-slate-100 bg-slate-50/80 p-6">
                    <div class="flex items-center justify-between mb-4">
                        <h2 class="text-lg font-semibold text-slate-800">Adresse principale</h2>
                        <span class="text-xs text-slate-400">Préremplie pour tes futures commandes</span>
                    </div>
                    {% if profileForm.primaryAddress is defined %}
                        {% set addressForm = profileForm.primaryAddress %}
                        <div class="space-y-5">
                            <div class="grid gap-4 md:grid-cols-2">
                                {{ form_row(addressForm.country, {'row_attr': {'class': 'md:col-span-1'}}) }}
                                {{ form_row(addressForm.label, {'row_attr': {'class': 'md:col-span-1'}}) }}
                            </div>
                            <div class="grid gap-4">
                                {{ form_row(addressForm.addressLine1) }}
                                {{ form_row(addressForm.addressLine2) }}
                            </div>
                            <div class="grid gap-4 md:grid-cols-2">
                                {{ form_row(addressForm.postalCode) }}
                                {{ form_row(addressForm.city) }}
                            </div>
                            <div class="grid gap-4 md:grid-cols-2">
                                {{ form_row(addressForm.state) }}
                            </div>
                            <div class="rounded-2xl border border-slate-200 bg-white p-4 flex flex-wrap gap-6 text-sm text-slate-700">
                                <label class="flex items-center gap-3 min-w-[180px]">
                                    {{ form_widget(addressForm.isDefault) }}
                                    <span>Adresse principale</span>
                                </label>
                                <label class="flex items-center gap-3 min-w-[180px]">
                                    {{ form_widget(addressForm.isShipping) }}
                                    <span>Pour la livraison</span>
                                </label>
                                <label class="flex items-center gap-3 min-w-[180px]">
                                    {{ form_widget(addressForm.isBilling) }}
                                    <span>Pour la facturation</span>
                                </label>
                            </div>
                        </div>
                    {% endif %}
                </div>

                <div class="flex justify-end">
                    <button type="submit" class="btn btn-primary px-10">
                        Mettre à jour mon profil
                    </button>
                </div>

                {{ form_end(profileForm) }}

                {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_VENDOR') %}
                    {% set totpEnabled = viewer is defined and viewer and viewer.isTotpAuthenticationEnabled() %}
                    <div class="mt-8 rounded-3xl border border-slate-200 bg-slate-50/80 p-6 flex items-center justify-between">
                        <div>
                            <h2 class="text-lg font-semibold text-slate-900">Double authentification</h2>
                            {% if totpEnabled %}
                                <p class="text-sm text-slate-600">La double authentification est active sur ton compte.</p>
                            {% else %}
                                <p class="text-sm text-slate-600">Active la verification TOTP pour securiser ton compte.</p>
                            {% endif %}
                        </div>
                        {% if totpEnabled %}
                            <span class="text-sm font-semibold text-emerald-600 uppercase tracking-wide">Activée</span>
                        {% else %}
                            <a href="{{ path('app_two_factor_setup') }}" class="btn btn-outline">Configurer</a>
                        {% endif %}
                    </div>
                {% endif %}

                {% if viewer and not viewer.vendor %}
                    <div class="mt-10 rounded-3xl border border-slate-200 bg-slate-50/80 p-6 flex flex-col gap-3">
                        <h2 class="text-lg font-semibold text-slate-900">Devenir vendeur TechNova</h2>
                        <p class="text-slate-600 text-sm">
                            Propose tes produits innovants sur la marketplace. Tu devras valider les règles vendeur puis
                            renseigner les informations de ta boutique.
                        </p>
                        <div class="flex justify-end">
                            <a href="{{ path('app_vendor_terms') }}" class="btn btn-primary">Créer ma boutique</a>
                        </div>
                    </div>
                {% endif %}

                <div class="mt-10 rounded-3xl border border-red-100 bg-red-50/80 p-6">
                    <h2 class="text-lg font-semibold text-red-900">Supprimer mon compte</h2>
                    <p class="text-sm text-red-800 mt-2">Cette action supprime définitivement ton compte.</p>
                    <form class="mt-4 flex justify-end" method="post" action="{{ path('app_profile_delete') }}" onsubmit="return confirm('Confirmer la suppression de ton compte ? Cette action est irréversible.');">
                        <input type="hidden" name="_token" value="{{ csrf_token('profile_delete') }}">
                        <button type="submit" class="btn btn-outline text-red-700 border-red-200 hover:bg-red-600 hover:text-white">Supprimer mon compte</button>
                    </form>
                </div>
            </div>

            <aside class="rounded-3xl bg-sky-50/80 p-6 shadow-[0_35px_80px_rgba(51,132,255,0.18)] flex flex-col justify-between">
                <div>
                    <h3 class="text-lg font-semibold mb-4">Rappels importants</h3>
                    <ul class="space-y-4 text-sm text-slate-600">
                        <li class="flex gap-3">
                            <span class="text-xl leading-none">📍</span>
                            Une adresse complète accélère les livraisons et facilite les points relais.
                        </li>
                        <li class="flex gap-3">
                            <span class="text-xl leading-none">🔐</span>
                            Les coordonnées restent privées et servent uniquement aux transporteurs.
                        </li>
                        <li class="flex gap-3">
                            <span class="text-xl leading-none">✨</span>
                            Les communications TechNova sont personnalisées selon tes préférences.
                        </li>
                    </ul>
                </div>
                <p class="mt-6 text-xs text-slate-500">
                    Tu pourras bientôt ajouter plusieurs adresses (domicile, bureau, point relais) dans cette même section.
                </p>
            </aside>
        </div>
    </div>
    </div>
</section>

<div id="avatar-error-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 px-4" role="alert" aria-live="assertive">
    <div class="w-full max-w-md rounded-3xl bg-white shadow-xl ring-1 ring-slate-900/10">
        <header class="flex items-center justify-between border-b border-slate-200 px-6 py-4">
            <h3 class="text-base font-semibold text-slate-900">Avatar non valide</h3>
            <button type="button" class="text-slate-400 hover:text-slate-700" data-avatar-error-close aria-label="Fermer">
                ✕
            </button>
        </header>
        <div class="p-6">
            <p id="avatar-error-message" class="text-sm text-red-600"></p>
        </div>
        <footer class="flex justify-end border-t border-slate-200 px-6 py-4">
            <button type="button" class="btn btn-primary px-6" data-avatar-error-close>J’ai compris</button>
        </footer>
    </div>
</div>

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        (() => {
            const MAX_AVATAR_BYTES = 2 * 1024 * 1024;
            const avatarInlineError = document.querySelector('[data-avatar-inline-error]');
            const avatarModal = document.getElementById('avatar-error-modal');
            const avatarModalMessage = document.getElementById('avatar-error-message');
            const modalCloseButtons = avatarModal
                ? Array.from(avatarModal.querySelectorAll('[data-avatar-error-close]'))
                : [];
            const serverAvatarErrors = {{ profileForm.avatarFile.vars.errors|length > 0 ? profileForm.avatarFile.vars.errors|map(e => e.message)|json_encode() : '[]' }};

            const showAvatarError = message => {
                if (!message) {
                    return;
                }
                if (avatarInlineError) {
                    avatarInlineError.textContent = message;
                }
                if (avatarModal) {
                    if (avatarModalMessage) {
                        avatarModalMessage.textContent = message;
                    }
                    avatarModal.classList.remove('hidden');
                }
            };

            const initializeAvatarPreview = () => {
                const fileInput = document.querySelector('[data-avatar-input]');
                const preview = document.querySelector('[data-avatar-preview]');
                const trigger = document.querySelector('[data-avatar-trigger]');

                if (!fileInput || !preview || !trigger) {
                    return;
                }

                if (fileInput.dataset.avatarPreviewHandled === 'true') {
                    return;
                }

                const previewImage = dataUrl => {
                    preview.innerHTML =
                        '<img src="' +
                        dataUrl +
                        '" alt="Nouvel avatar" class="absolute inset-0 h-full w-full object-cover object-center">';
                    const overlay = document.createElement('div');
                    overlay.className =
                        'pointer-events-none absolute inset-0 bg-slate-900/40 text-white text-xs font-semibold uppercase tracking-wide flex items-center justify-center opacity-0 transition group-hover:opacity-100';
                    overlay.textContent = 'Changer';
                    preview.appendChild(overlay);
                };

                trigger.addEventListener('click', () => fileInput.click());
                trigger.addEventListener('keydown', event => {
                    if (event.key === 'Enter' || event.key === ' ') {
                        event.preventDefault();
                        fileInput.click();
                    }
                });

                fileInput.addEventListener('change', () => {
                    const [file] = fileInput.files ?? [];
                    if (!file) {
                        return;
                    }
                    if (file.size > MAX_AVATAR_BYTES) {
                        const sizeInMb = (file.size / (1024 * 1024)).toFixed(2);
                        showAvatarError(`Ton fichier fait ${sizeInMb} Mo, il dépasse la limite de 2 Mo.`);
                        fileInput.value = '';
                        return;
                    }
                    const reader = new FileReader();
                    reader.onload = event => previewImage(event.target.result);
                    reader.readAsDataURL(file);
                });

                fileInput.dataset.avatarPreviewHandled = 'true';
            };

            document.addEventListener('DOMContentLoaded', initializeAvatarPreview);
            document.addEventListener('turbo:load', initializeAvatarPreview);

            modalCloseButtons.forEach(button => button.addEventListener('click', () => {
                avatarModal?.classList.add('hidden');
            }));

            if (serverAvatarErrors.length > 0) {
                showAvatarError(serverAvatarErrors[0]);
            }
        })();
    </script>
{% endblock %}
