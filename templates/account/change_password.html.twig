{% extends 'base.html.twig' %}

{% block title %}Changer mon mot de passe | TechNova{% endblock %}

{% form_theme changePasswordForm 'form/tailwind_form_theme.html.twig' %}

{% block body %}
<section class="tn-main max-w-3xl mx-auto">
    <div class="rounded-[38px] bg-white p-10 shadow-[0_40px_90px_rgba(15,25,36,0.08)]">
        <div class="space-y-3 mb-8">
            <p class="text-xs font-semibold tracking-[0.35em] text-slate-400 uppercase mb-2">Sécurité</p>
            <h1 class="text-3xl font-bold">Changer mon mot de passe</h1>
            <p class="text-slate-500">
                Choisis un nouveau mot de passe d'au moins 8 caractères.
            </p>
        </div>

        {% for message in app.flashes('success') %}
            <div class="mb-5 rounded-2xl border border-green-200 bg-green-50 px-4 py-3 text-green-800">
                {{ message }}
            </div>
        {% endfor %}

        {% for message in app.flashes('error') %}
            <div class="mb-5 rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-red-800">
                {{ message }}
            </div>
        {% endfor %}

        <form method="post" class="space-y-6">
            {{ form_start(changePasswordForm, { render_rest: false }) }}

            <div class="rounded-3xl border border-slate-100 bg-slate-50/80 p-6 space-y-4">
                {{ form_row(changePasswordForm.plainPassword.first) }}
                {{ form_row(changePasswordForm.plainPassword.second) }}
            </div>

            <div class="flex gap-4 justify-end">
                <a href="{{ path('app_profile') }}" class="btn btn-outline">Annuler</a>
                <button type="submit" class="btn btn-primary px-10">Mettre à jour</button>
            </div>

            {{ form_end(changePasswordForm) }}
        </form>
    </div>
</section>
{% endblock %}
