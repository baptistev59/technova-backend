{% extends 'base.html.twig' %}

{% block title %}Mes favoris{% endblock %}

{% block body %}
<section class="tn-main max-w-6xl mx-auto">
    <div class="rounded-[38px] bg-white p-10 shadow-[0_40px_90px_rgba(15,25,36,0.08)]">
        <!-- Header -->
        <div class="mb-8">
            <p class="text-xs font-semibold tracking-[0.35em] text-slate-400 uppercase mb-2">Technova</p>
            <h1 class="text-3xl font-bold mb-2">Mes favoris</h1>
            <p class="text-slate-500">
                {% if wishlist_count > 0 %}
                    Vous avez {{ wishlist_count }} produit{{ wishlist_count > 1 ? 's' : '' }} en favori{{ wishlist_count > 1 ? 's' : '' }}.
                {% else %}
                    Aucun produit en favori pour le moment.
                {% endif %}
            </p>
        </div>

        <!-- Flash messages -->
        {% for message in app.flashes('success') %}
            <div class="mb-5 rounded-2xl border border-green-200 bg-green-50 px-4 py-3 text-green-800">
                {{ message }}
            </div>
        {% endfor %}

        {% for message in app.flashes('error') %}
            <div class="mb-5 rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-red-800">
                {{ message }}
            </div>
        {% endfor %}

        <!-- Empty state -->
        {% if wishlists is empty %}
            <div class="text-center py-16">
                <div class="mb-4 text-6xl">💔</div>
                <h2 class="text-xl font-semibold text-slate-700 mb-2">Pas de favoris</h2>
                <p class="text-slate-500 mb-6">
                    Vous n'avez pas encore ajouté de produit à vos favoris.
                </p>
                <a href="{{ path('app_catalog') }}" class="inline-block px-6 py-3 bg-slate-800 text-white rounded-xl hover:bg-slate-900 transition">
                    Explorer le catalogue
                </a>
            </div>
        {% else %}
            <!-- Wishlists Grid -->
            <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
                {% for wishlist in wishlists %}
                    {% set product = wishlist.product %}
                    <div class="rounded-2xl border border-slate-200 overflow-hidden hover:shadow-lg transition">
                        <!-- Product Image -->
                        <div class="aspect-square bg-slate-100 relative overflow-hidden group">
                            {% if product.images is not empty %}
                                {% set mainImage = product.images[0] %}
                                <img src="{{ mainImage.url ?? asset(mainImage.path) }}" 
                                     alt="{{ product.name }}" 
                                     class="w-full h-full object-cover group-hover:scale-105 transition">
                            {% else %}
                                <div class="w-full h-full flex items-center justify-center text-slate-400">
                                    Pas d'image
                                </div>
                            {% endif %}

                            <!-- Remove button (floating) -->
                            <form method="POST" action="{{ path('app_wishlist_delete', {id: wishlist.id}) }}" 
                                  class="absolute top-2 right-2 opacity-0 group-hover:opacity-100 transition"
                                  onsubmit="return confirm('Retirer ce produit de tes favoris ?')">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_wishlist_' ~ wishlist.id) }}">
                                <button type="submit" class="bg-white rounded-full p-2 shadow-md hover:bg-red-50 transition" 
                                        aria-label="Retirer des favoris">
                                    <svg class="w-5 h-5 text-red-600" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd"/>
                                    </svg>
                                </button>
                            </form>
                        </div>

                        <!-- Product Info -->
                        <div class="p-4">
                            <div class="mb-2">
                                <a href="{{ path('app_product_show', {slug: product.slug}) }}" 
                                   class="font-semibold text-slate-800 hover:text-slate-600 transition line-clamp-2">
                                    {{ product.name }}
                                </a>
                            </div>

                            <!-- Shop -->
                            {% if product.shop %}
                                <p class="text-xs text-slate-500 mb-3">
                                    {{ product.shop.name }}
                                </p>
                            {% endif %}

                            <!-- Price -->
                            <div class="mb-4 flex items-baseline gap-2">
                                {% if product.minPrice != product.maxPrice %}
                                    <span class="text-sm text-slate-500">À partir de</span>
                                {% endif %}
                                <span class="text-lg font-bold text-slate-800">
                                    {{ product.minPrice|number_format(2, ',', ' ') }} €
                                </span>
                            </div>

                            <!-- Actions -->
                            <div class="flex gap-2">
                                <a href="{{ path('app_product_show', {slug: product.slug}) }}" 
                                   class="flex-1 px-4 py-2 bg-slate-100 text-slate-800 rounded-lg hover:bg-slate-200 transition text-center text-sm font-medium">
                                    Voir le produit
                                </a>
                                <form method="POST" action="{{ path('app_cart_add') }}" class="flex-1">
                                    <input type="hidden" name="productId" value="{{ product.id }}">
                                    <input type="hidden" name="quantity" value="1">
                                    <input type="hidden" name="_token" value="{{ csrf_token('add_to_cart') }}">
                                    <button type="submit" class="w-full px-4 py-2 bg-slate-800 text-white rounded-lg hover:bg-slate-900 transition text-sm font-medium">
                                        Ajouter au panier
                                    </button>
                                </form>
                            </div>

                            <!-- Added date -->
                            <p class="text-xs text-slate-400 mt-3">
                                Ajouté le {{ wishlist.createdAt|date('d/m/Y à H:i') }}
                            </p>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</section>
{% endblock %}
