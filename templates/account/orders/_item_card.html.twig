<div class="flex items-center gap-4 rounded-2xl border border-slate-100 p-4">
    <div class="h-16 w-16 rounded-2xl bg-slate-50 overflow-hidden flex items-center justify-center">
        {% if item.productImage %}
            {% set imageUrl = item.productImage starts with 'http' ? item.productImage : asset(item.productImage) %}
            <img src="{{ imageUrl }}" alt="{{ item.productName }}" class="h-full w-full object-cover">
        {% else %}
            <span class="text-xs text-slate-400">image</span>
        {% endif %}
    </div>
    <div class="flex-1">
        <p class="font-medium text-slate-900">{{ item.productName }}</p>
        <p class="text-sm text-slate-500">Quantité : {{ item.quantity }}</p>
    </div>
    <div class="text-right">
        <p class="text-sm text-slate-500">{{ item.unitPrice|number_format(2, ',', ' ') }} € / unité</p>
        <p class="text-lg font-semibold text-slate-900">{{ item.lineTotal|number_format(2, ',', ' ') }} €</p>
        <p class="text-[0.65rem] uppercase tracking-[0.35em] mt-1 text-slate-500">{{ item.fulfillmentStatus.label() }}</p>
    </div>
</div>
<div class="rounded-2xl border border-slate-100 bg-slate-50 p-4 ml-20">
    {% if order.isPaid %}
        {% if review %}
            <p class="text-sm text-slate-700">
                <span class="font-semibold">Votre avis :</span> {{ review.rating }}/5
            </p>
            {% if review.comment %}
                <div class="text-sm text-slate-500 mt-1">{{ review.comment|raw }}</div>
            {% endif %}
            <details class="mt-3">
                <summary class="cursor-pointer text-xs font-semibold uppercase tracking-[0.3em] text-blue-600">Modifier l’avis</summary>
                <form method="post"
                      action="{{ path('app_account_orders_review', { reference: order.reference }) }}"
                      class="space-y-3 mt-3">
                    <input type="hidden" name="_token" value="{{ csrf_token('review_' ~ order.id ~ '_' ~ item.productId) }}">
                    <input type="hidden" name="product_id" value="{{ item.productId }}">
                    <div class="grid gap-3 md:grid-cols-2">
                        <div>
                            <label class="text-xs font-semibold text-slate-500 uppercase tracking-[0.3em]" for="review-edit-rating-{{ item.productId }}">Note</label>
                            <select id="review-edit-rating-{{ item.productId }}" name="rating" class="tn-select rounded-2xl border border-slate-200 bg-white px-4 py-2 w-full mt-1" required>
                                {% for value in 0..5 %}
                                    <option value="{{ value }}" {{ review.rating|round == value ? 'selected' : '' }}>{{ value }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div>
                            <label class="text-xs font-semibold text-slate-500 uppercase tracking-[0.3em]">Commentaire</label>
                            <textarea name="comment"
                                      data-trix="true"
                                      rows="2"
                                      class="tn-textarea w-full resize-none mt-1"
                                      placeholder="Détaillez votre expérience (optionnel)">{{ review.comment }}</textarea>
                        </div>
                    </div>
                    <div class="flex items-center justify-end">
                        <button class="btn btn-primary btn-sm" type="submit">Mettre à jour</button>
                    </div>
                </form>
            </details>
        {% else %}
            <form method="post"
                  action="{{ path('app_account_orders_review', { reference: order.reference }) }}"
                  class="space-y-3">
                <input type="hidden" name="_token" value="{{ csrf_token('review_' ~ order.id ~ '_' ~ item.productId) }}">
                <input type="hidden" name="product_id" value="{{ item.productId }}">
                <div class="grid gap-3 md:grid-cols-2">
                    <div>
                        <label class="text-xs font-semibold text-slate-500 uppercase tracking-[0.3em]" for="review-new-rating-{{ item.productId }}">Note</label>
                        <select id="review-new-rating-{{ item.productId }}" name="rating" class="tn-select rounded-2xl border border-slate-200 bg-white px-4 py-2 w-full mt-1" required>
                            {% for value in 0..5 %}
                                <option value="{{ value }}">{{ value }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div>
                        <label class="text-xs font-semibold text-slate-500 uppercase tracking-[0.3em]">Commentaire</label>
                        <textarea name="comment"
                                  data-trix="true"
                                  rows="2"
                                  class="tn-textarea w-full resize-none mt-1"
                                  placeholder="Détaillez votre expérience (optionnel)"></textarea>
                    </div>
                </div>
                <div class="flex items-center justify-end">
                    <button class="btn btn-primary btn-sm" type="submit">Publier l’avis</button>
                </div>
            </form>
        {% endif %}
    {% else %}
        <p class="text-sm text-slate-500">
            Les avis sont disponibles une fois la commande payée.
        </p>
    {% endif %}
</div>
