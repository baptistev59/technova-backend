{% extends 'base.html.twig' %}

{% block title 'Commande ' ~ order.reference %}

{% block body %}
<section class="tn-section max-w-4xl mx-auto space-y-6">
    {% set statusLabels = {
        'pending': 'En attente de paiement',
        'paid': 'Payée',
        'cancelled': 'Annulée'
    } %}
    <div class="rounded-3xl border border-slate-200 bg-white p-6">
        <div class="flex flex-wrap justify-between gap-4">
            <div>
                <p class="text-sm text-slate-500">Référence</p>
                <h1 class="text-2xl font-bold text-slate-900">{{ order.reference }}</h1>
            </div>
            <div class="text-right">
                <p class="text-sm text-slate-500">Statut</p>
                <p class="text-lg font-semibold text-slate-900">
                    {{ statusLabels[order.status] ?? order.status|capitalize }}
                </p>
                <p class="text-xs text-slate-500 mt-1">Créée le {{ order.createdAt|date('d/m/Y à H\\hi') }}</p>
            </div>
        </div>
    </div>

    <div class="rounded-3xl border border-slate-200 bg-white p-6 space-y-4">
        <h2 class="text-lg font-semibold text-slate-900">Articles</h2>
        <div class="space-y-4">
            {% for item in order.items %}
                {% set review = reviews_by_product[item.productId] ?? null %}
                <div class="flex items-center gap-4 rounded-2xl border border-slate-100 p-4">
                    <div class="h-16 w-16 rounded-2xl bg-slate-50 overflow-hidden flex items-center justify-center">
                        {% if item.productImage %}
                            {% set imageUrl = item.productImage starts with 'http' ? item.productImage : asset(item.productImage) %}
                            <img src="{{ imageUrl }}" alt="{{ item.productName }}" class="h-full w-full object-cover">
                        {% else %}
                            <span class="text-xs text-slate-400">image</span>
                        {% endif %}
                    </div>
                    <div class="flex-1">
                        <p class="font-medium text-slate-900">{{ item.productName }}</p>
                        <p class="text-sm text-slate-500">Quantité : {{ item.quantity }}</p>
                    </div>
                    <div class="text-right">
                        <p class="text-sm text-slate-500">{{ item.unitPrice|number_format(2, ',', ' ') }} € / unité</p>
                        <p class="text-lg font-semibold text-slate-900">{{ item.lineTotal|number_format(2, ',', ' ') }} €</p>
                    </div>
                </div>
                <div class="rounded-2xl border border-slate-100 bg-slate-50 p-4 ml-20">
                    {% if order.isPaid %}
                        {% if review %}
                            <p class="text-sm text-slate-700">
                                <span class="font-semibold">Votre avis :</span> {{ review.rating }}/5
                            </p>
                            {% if review.comment %}
                                <div class="text-sm text-slate-500 mt-1">{{ review.comment|raw }}</div>
                            {% endif %}
                            <details class="mt-3">
                                <summary class="cursor-pointer text-xs font-semibold uppercase tracking-[0.3em] text-blue-600">Modifier l’avis</summary>
                                <form method="post"
                                      action="{{ path('app_account_orders_review', { reference: order.reference }) }}"
                                      class="space-y-3 mt-3">
                                    <input type="hidden" name="_token" value="{{ csrf_token('review_' ~ order.id ~ '_' ~ item.productId) }}">
                                    <input type="hidden" name="product_id" value="{{ item.productId }}">
                                    <div class="grid gap-3 md:grid-cols-2">
                                        <div>
                                            <label class="text-xs font-semibold text-slate-500 uppercase tracking-[0.3em]" for="review-edit-rating-{{ item.productId }}">Note</label>
                                            <select id="review-edit-rating-{{ item.productId }}" name="rating" class="tn-select rounded-2xl border border-slate-200 bg-white px-4 py-2 w-full mt-1" required>
                                                {% for value in 0..5 %}
                                                    <option value="{{ value }}" {{ review.rating|round == value ? 'selected' : '' }}>{{ value }}</option>
                                                {% endfor %}
                                            </select>
                                        </div>
                                        <div>
                                            <label class="text-xs font-semibold text-slate-500 uppercase tracking-[0.3em]">Commentaire</label>
                                            <textarea name="comment"
                                                      data-trix="true"
                                                      rows="2"
                                                      class="tn-textarea w-full resize-none mt-1"
                                                      placeholder="Détaillez votre expérience (optionnel)">{{ review.comment }}</textarea>
                                        </div>
                                    </div>
                                    <div class="flex items-center justify-end">
                                        <button class="btn btn-primary btn-sm" type="submit">Mettre à jour</button>
                                    </div>
                                </form>
                            </details>
                        {% else %}
                            <form method="post"
                                  action="{{ path('app_account_orders_review', { reference: order.reference }) }}"
                                  class="space-y-3">
                                <input type="hidden" name="_token" value="{{ csrf_token('review_' ~ order.id ~ '_' ~ item.productId) }}">
                                <input type="hidden" name="product_id" value="{{ item.productId }}">
                                <div class="grid gap-3 md:grid-cols-2">
                                    <div>
                                        <label class="text-xs font-semibold text-slate-500 uppercase tracking-[0.3em]" for="review-new-rating-{{ item.productId }}">Note</label>
                                        <select id="review-new-rating-{{ item.productId }}" name="rating" class="tn-select rounded-2xl border border-slate-200 bg-white px-4 py-2 w-full mt-1" required>
                                            {% for value in 0..5 %}
                                                <option value="{{ value }}">{{ value }}</option>
                                            {% endfor %}
                                        </select>
                                    </div>
                                    <div>
                                        <label class="text-xs font-semibold text-slate-500 uppercase tracking-[0.3em]">Commentaire</label>
                                        <textarea name="comment"
                                                  data-trix="true"
                                                  rows="2"
                                                  class="tn-textarea w-full resize-none mt-1"
                                                  placeholder="Détaillez votre expérience (optionnel)"></textarea>
                                    </div>
                                </div>
                                <div class="flex items-center justify-end">
                                    <button class="btn btn-primary btn-sm" type="submit">Publier l’avis</button>
                                </div>
                            </form>
                        {% endif %}
                    {% else %}
                        <p class="text-sm text-slate-500">
                            Les avis sont disponibles une fois la commande payée.
                        </p>
                    {% endif %}
                </div>
            {% endfor %}
        </div>
        <div class="flex items-center justify-between border-t border-slate-100 pt-4">
            <span class="text-xl font-semibold text-slate-900">Total</span>
            <span class="text-2xl font-bold text-slate-900">{{ order.totalAmount|number_format(2, ',', ' ') }} €</span>
        </div>
    </div>

    <div class="rounded-3xl border border-slate-200 bg-white p-6">
        <h2 class="text-lg font-semibold text-slate-900">Adresse de livraison</h2>
        {% set address = order.shippingAddress %}
        <p class="mt-2 text-sm text-slate-600">
            {{ address.addressLine1 }}<br>
            {% if address.addressLine2 %}{{ address.addressLine2 }}<br>{% endif %}
            {{ address.postalCode }} {{ address.city }}<br>
            {{ address.country }}
        </p>
    </div>

    <div class="rounded-3xl border border-slate-200 bg-white p-6">
        <h2 class="text-lg font-semibold text-slate-900 mb-4">Messagerie commande</h2>
        <div class="space-y-3">
            <div class="tn-conversation-panel" data-order-id="{{ order.id }}" data-api-base="/api/account/conversations">
                <div class="space-y-2 max-h-48 overflow-y-auto" data-conversation-messages>
                    <p class="text-sm text-slate-400">Chargement en cours…</p>
                </div>
                <form class="space-y-2" data-conversation-form>
                    <label class="text-xs font-semibold text-slate-500 uppercase tracking-[0.3em]">Nouveau message</label>
                    <textarea name="content" rows="3" class="tn-textarea w-full resize-none" placeholder="Parler au vendeur…" data-trix="true" required></textarea>
                    <div class="flex items-center justify-between">
                        <p class="text-xs text-red-500" data-conversation-status></p>
                        <button class="btn btn-primary btn-sm" type="submit">Envoyer</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

        <div class="flex flex-wrap gap-3">
            <button
                type="button"
                class="btn btn-outline"
                data-order-doc
                data-order-id="{{ order.id }}"
                data-type="invoice"
            >
                Imprimer la facture
            </button>
            <a class="btn btn-outline" href="{{ path('app_account_orders') }}">Retour aux commandes</a>
            <a class="btn btn-primary" href="{{ path('catalog_index') }}">Continuer mes achats</a>
        </div>
</section>
{% endblock %}
