{% extends 'base.html.twig' %}

{% block title 'Commande ' ~ order.reference %}

{% block body %}
<section class="tn-section max-w-4xl mx-auto space-y-6">
    {% set statusLabels = {
        'pending': 'En attente de paiement',
        'paid': 'Payée',
        'cancelled': 'Annulée'
    } %}
    <div class="rounded-3xl border border-slate-200 bg-white p-6">
        <div class="flex flex-wrap justify-between gap-4">
            <div>
                <p class="text-sm text-slate-500">Référence</p>
                <h1 class="text-2xl font-bold text-slate-900">{{ order.reference }}</h1>
            </div>
            <div class="text-right">
                <p class="text-sm text-slate-500">Statut</p>
                <p class="text-lg font-semibold text-slate-900">
                    {{ statusLabels[order.status] ?? order.status|capitalize }}
                </p>
                {% if order.refundedAt %}
                    <p class="text-xs text-rose-600 mt-1">Remboursée le {{ order.refundedAt|date('d/m/Y H:i') }}</p>
                {% endif %}
                <p class="text-xs text-slate-500 mt-1">Créée le {{ order.createdAt|date('d/m/Y à H\\hi') }}</p>
            </div>
        </div>
    </div>

    <div class="rounded-3xl border border-slate-200 bg-white p-6 space-y-4">
        <h2 class="text-lg font-semibold text-slate-900">Articles</h2>
        {% set shippedItems = order.items|filter(item => item.fulfillmentStatus.value == 'shipped') %}
        {% set pendingItems = order.items|filter(item => item.fulfillmentStatus.value != 'shipped') %}
        <div class="space-y-4">
            <section class="space-y-3">
                <h3 class="text-sm font-semibold text-slate-900">Articles expédiés</h3>
                {% if shippedItems is empty %}
                    <p class="text-sm text-slate-500">Aucun article expédié pour le moment.</p>
                {% else %}
                    {% for item in shippedItems %}
                        {% set review = reviews_by_product[item.productId] ?? null %}
                        {% include 'account/orders/_item_card.html.twig' with { item: item, review: review, order: order } %}
                    {% endfor %}
                {% endif %}
            </section>
            {% if pendingItems is not empty %}
                <section class="space-y-3">
                    <h3 class="text-sm font-semibold text-slate-900">Articles en attente</h3>
                    {% for item in pendingItems %}
                        {% set review = reviews_by_product[item.productId] ?? null %}
                        {% include 'account/orders/_item_card.html.twig' with { item: item, review: review, order: order } %}
                    {% endfor %}
                </section>
            {% endif %}
            {% if order.shippingTotal is defined %}
                <div class="flex items-center justify-between text-sm text-slate-600">
                    <span>Livraison</span>
                    <span>{{ order.shippingTotal|number_format(2, ',', ' ') }} €</span>
                </div>
            {% endif %}
            <div class="flex items-center justify-between border-t border-slate-100 pt-4">
                <span class="text-xl font-semibold text-slate-900">Total</span>
                <span class="text-2xl font-bold text-slate-900">{{ order.totalAmount|number_format(2, ',', ' ') }} €</span>
            </div>
        </div>
    </div>

    <div class="rounded-3xl border border-slate-200 bg-white p-6">
        <h2 class="text-lg font-semibold text-slate-900">Adresse de livraison</h2>
        {% set address = order.shippingAddress %}
        <p class="mt-2 text-sm text-slate-600">
            {{ address.addressLine1 }}<br>
            {% if address.addressLine2 %}{{ address.addressLine2 }}<br>{% endif %}
            {{ address.postalCode }} {{ address.city }}<br>
            {{ address.country }}
        </p>
    </div>

    {% if order.shippingLines %}
        <div class="rounded-3xl border border-slate-200 bg-white p-6">
            <h2 class="text-lg font-semibold text-slate-900">Livraison</h2>
            <div class="mt-2 space-y-2 text-sm text-slate-600">
                {% for line in order.shippingLines %}
                    <div class="flex items-center justify-between">
                        <span>
                            {{ line.shopName ?? 'Boutique' }} · {{ line.methodName ?? 'Livraison' }}
                        </span>
                        <span class="font-semibold text-slate-900">{{ line.price|number_format(2, ',', ' ') }} €</span>
                    </div>
                {% endfor %}
            </div>
        </div>
    {% endif %}

    <div class="rounded-3xl border border-slate-200 bg-white p-6">
        <h2 class="text-lg font-semibold text-slate-900">Demande de retour</h2>
        {% if return_request %}
            {% set returnLabel = {
                'pending': 'En attente',
                'approved': 'Validée',
                'rejected': 'Refusée'
            } %}
            <p class="mt-2 text-sm text-slate-600">
                Statut : <span class="font-semibold text-slate-900">{{ returnLabel[return_request.status.value] ?? return_request.status.value }}</span>
            </p>
            <p class="mt-2 text-sm text-slate-600">
                Motif : <span class="text-slate-900">{{ return_request.reason }}</span>
            </p>
            {% if return_request.details %}
                <p class="mt-1 text-sm text-slate-500">{{ return_request.details }}</p>
            {% endif %}
        {% else %}
            {% if order.isPaid %}
                <form method="post" action="{{ path('app_account_orders_return', { reference: order.reference }) }}" class="mt-3 space-y-3">
                    <input type="hidden" name="_token" value="{{ csrf_token('return_' ~ order.id) }}">
                    <div>
                        <label class="text-xs font-semibold text-slate-500 uppercase tracking-[0.3em]" for="return-reason">Motif</label>
                        <input id="return-reason" name="reason" class="tn-input w-full mt-1" required>
                    </div>
                    <div>
                        <label class="text-xs font-semibold text-slate-500 uppercase tracking-[0.3em]" for="return-details">Détails (optionnel)</label>
                        <textarea id="return-details" name="details" rows="3" class="tn-textarea w-full resize-none mt-1"></textarea>
                    </div>
                    <div class="flex items-center justify-end">
                        <button class="btn btn-primary btn-sm" type="submit">Envoyer la demande</button>
                    </div>
                </form>
            {% else %}
                <p class="mt-2 text-sm text-slate-500">
                    La demande de retour est disponible une fois la commande payée.
                </p>
            {% endif %}
        {% endif %}
    </div>

    <div class="rounded-3xl border border-slate-200 bg-white p-6">
        <h2 class="text-lg font-semibold text-slate-900 mb-4">Messagerie commande</h2>
        <div class="space-y-3">
            <div class="tn-conversation-panel" data-order-id="{{ order.id }}" data-api-base="/api/account/conversations">
                <div class="space-y-2 max-h-48 overflow-y-auto" data-conversation-messages>
                    <p class="text-sm text-slate-400">Chargement en cours…</p>
                </div>
                <form class="space-y-2" data-conversation-form>
                    <label class="text-xs font-semibold text-slate-500 uppercase tracking-[0.3em]">Nouveau message</label>
                    <textarea name="content" rows="3" class="tn-textarea w-full resize-none" placeholder="Parler au vendeur…" data-trix="true" required></textarea>
                    <div class="flex items-center justify-between">
                        <p class="text-xs text-red-500" data-conversation-status></p>
                        <button class="btn btn-primary btn-sm" type="submit">Envoyer</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

        <div class="flex flex-wrap gap-3">
            <a
                class="btn btn-outline"
                href="{{ path('app_account_orders_invoice', {reference: order.reference}) }}"
                data-turbo="false"
                target="_blank"
                rel="noopener"
            >
                Imprimer la facture
            </a>
            <a class="btn btn-outline" href="{{ path('app_account_orders') }}">Retour aux commandes</a>
            <a class="btn btn-primary" href="{{ path('catalog_index') }}">Continuer mes achats</a>
        </div>
</section>
{% endblock %}
