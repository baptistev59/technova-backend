    "@symfony/webpack-encore": "^5.3.1",
    "autoprefixer": "^10.4.22",
    "babel-loader": "^9.1.3",
    "core-js": "^3.32.1",
    "css-loader": "^6.8.1",
    "postcss": "^8.5.6",
